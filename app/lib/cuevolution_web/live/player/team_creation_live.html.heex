<PlayerComponents.app_shell
  current_player={@current_player}
  active={:team}
  flash={@flash}
  pending_invitations={@pending_invitations}
  identification_form={@identification_form}
>
  <PlayerComponents.eyebrow>Your Team</PlayerComponents.eyebrow>

  <div class="mx-auto max-w-lg py-4 text-center sm:py-10">
    <div class="mx-auto mb-4 flex size-14 items-center justify-center rounded-2xl bg-ink-950 text-2xl font-bold text-ink-25">
      +
    </div>
    <h1 class="mb-2 text-xl font-bold tracking-tight text-ink-950 sm:text-2xl">
      You're not on a team yet
    </h1>
    <p class="mb-2 text-[14.5px] leading-relaxed text-ink-500">
      New teams are now set up by tournament admins rather than players directly.
    </p>
    <p class="text-[14.5px] leading-relaxed text-ink-500">
      If you'd like to captain or join a team, reach out to a tournament director or your
      regional coordinator.
    </p>
  </div>
</PlayerComponents.app_shell>
