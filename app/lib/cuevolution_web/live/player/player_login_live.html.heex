<PlayerComponents.guest_shell flash={@flash}>
  <PlayerComponents.eyebrow class="mb-2.5">Player Sign In</PlayerComponents.eyebrow>
  <h1 class="mb-1.5 text-2xl font-bold tracking-tight text-ink-950">Welcome back</h1>
  <p class="mb-6 text-[15px] leading-relaxed text-ink-500">
    Sign in to check standings, your team and fixtures.
  </p>

  <.form for={@form} action={~p"/login"} method="post">
    <PlayerComponents.input
      field={@form[:login]}
      label="Email or username"
      placeholder="you@example.com"
      required
    />
    <PlayerComponents.input
      field={@form[:password]}
      type="password"
      label="Password"
      placeholder="••••••••"
      required
    />
    <div class="-mt-2 mb-4.5 text-right">
      <.link
        navigate={~p"/forgot-password"}
        class="text-[13px] font-semibold text-red-600 hover:text-red-700"
      >
        Forgot password?
      </.link>
    </div>
    <PlayerComponents.button type="submit" variant="primary" full_width>
      Sign in
    </PlayerComponents.button>
  </.form>

  <p class="mt-5 text-center text-[13.5px] text-ink-500">
    New to Sportpesa Pool League?
    <.link navigate={~p"/register"} class="font-semibold text-red-600 hover:text-red-700">
      Create an account
    </.link>
  </p>
</PlayerComponents.guest_shell>
