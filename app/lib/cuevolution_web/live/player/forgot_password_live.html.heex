<PlayerComponents.guest_shell flash={@flash}>
  <div :if={@stage == :request}>
    <PlayerComponents.eyebrow class="mb-2.5">Reset Password</PlayerComponents.eyebrow>
    <h1 class="mb-1.5 text-2xl font-bold tracking-tight text-ink-950">Forgot your password?</h1>
    <p class="mb-6 text-[15px] leading-relaxed text-ink-500">
      Enter the email or username on your account and we'll send a link to reset it.
    </p>

    <.form for={@form} phx-submit="send_reset">
      <PlayerComponents.input
        field={@form[:login]}
        label="Email or username"
        placeholder="you@example.com"
        required
      />
      <div
        :if={@error}
        class="-mt-2 mb-4 rounded-[10px] border border-red-100 bg-red-50 px-3 py-2.5 text-[13px] font-medium text-red-700"
      >
        {@error}
      </div>
      <PlayerComponents.button type="submit" variant="primary" full_width>
        Send reset link
      </PlayerComponents.button>
    </.form>

    <p class="mt-5 text-center text-[13.5px] text-ink-500">
      <.link navigate={~p"/login"} class="font-semibold text-red-600 hover:text-red-700">
        Back to sign in
      </.link>
    </p>
  </div>

  <div :if={@stage == :sent} class="text-center">
    <div class="mx-auto mb-4.5 flex size-[52px] items-center justify-center rounded-full bg-red-50 text-2xl text-red-600">
      ✉
    </div>
    <h1 class="mb-2 text-xl font-bold tracking-tight text-ink-950">Check your email</h1>
    <p class="mb-2 text-[15px] leading-relaxed text-ink-500">
      If <strong class="text-ink-950">{@login}</strong> matches an account, we've sent a password
      reset link to its registered email. Click the link to choose a new password — it expires
      in 20 minutes.
    </p>
    <p class="mt-5 text-center text-[13.5px] text-ink-500">
      Didn't get it?
      <a href="#" phx-click="resend" class="font-semibold text-red-600 hover:text-red-700">
        Resend email
      </a>
      ·
      <.link navigate={~p"/login"} class="font-semibold text-red-600 hover:text-red-700">
        Back to sign in
      </.link>
    </p>
  </div>
</PlayerComponents.guest_shell>
