<PlayerComponents.guest_shell flash={@flash}>
  <div :if={@stage == :form}>
    <PlayerComponents.eyebrow class="mb-2.5">Reset Password</PlayerComponents.eyebrow>
    <h1 class="mb-1.5 text-2xl font-bold tracking-tight text-ink-950">Choose a new password</h1>
    <p class="mb-6 text-[15px] leading-relaxed text-ink-500">
      Must be 8-15 characters, with an uppercase letter, a number, and a special character.
    </p>

    <.form for={@form} phx-submit="reset_password">
      <PlayerComponents.input
        field={@form[:password]}
        type="password"
        label="New password"
        placeholder="••••••••"
        required
      />
      <PlayerComponents.input
        field={@form[:password_confirmation]}
        type="password"
        label="Confirm password"
        placeholder="••••••••"
        required
      />
      <PlayerComponents.button type="submit" variant="primary" full_width>
        Reset password
      </PlayerComponents.button>
    </.form>

    <p class="mt-5 text-center text-[13.5px] text-ink-500">
      <.link navigate={~p"/login"} class="font-semibold text-red-600 hover:text-red-700">
        Back to sign in
      </.link>
    </p>
  </div>

  <div :if={@stage == :invalid} class="text-center">
    <div class="mx-auto mb-4.5 flex size-[52px] items-center justify-center rounded-full bg-red-50 text-2xl text-red-600">
      !
    </div>
    <h1 class="mb-2 text-xl font-bold tracking-tight text-ink-950">Link invalid or expired</h1>
    <p class="mb-6 text-[15px] leading-relaxed text-ink-500">
      This password reset link is no longer valid. Request a new one to continue.
    </p>
    <PlayerComponents.button navigate={~p"/forgot-password"} variant="primary" full_width>
      Request a new link
    </PlayerComponents.button>
  </div>

  <div :if={@stage == :done} class="text-center">
    <div class="mx-auto mb-4.5 flex size-[52px] items-center justify-center rounded-full bg-green-50 text-2xl text-green-600">
      ✓
    </div>
    <h1 class="mb-2 text-xl font-bold tracking-tight text-ink-950">Password reset</h1>
    <p class="mb-6 text-[15px] leading-relaxed text-ink-500">
      Your password has been updated. Sign in with your new password.
    </p>
    <PlayerComponents.button navigate={~p"/login"} variant="primary" full_width>
      Back to sign in
    </PlayerComponents.button>
  </div>
</PlayerComponents.guest_shell>
