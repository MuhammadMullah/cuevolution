<PlayerComponents.app_shell
  current_player={@current_player}
  active={:team}
  flash={@flash}
  pending_invitations={@pending_invitations}
>
  <PlayerComponents.eyebrow>Your Team</PlayerComponents.eyebrow>

  <div class="mb-6 flex flex-wrap items-center gap-3.5">
    <div class="flex size-14 shrink-0 items-center justify-center rounded-2xl bg-ink-950 text-xl font-bold text-ink-25">
      {team_initials(@team.name)}
    </div>
    <div class="min-w-[200px] flex-1">
      <%= if @editing_team_name? do %>
        <.form for={@team_name_form} id="team-name-form" phx-submit="update_team_name">
          <div class="flex flex-col gap-2 sm:flex-row sm:items-start">
            <PlayerComponents.input
              field={@team_name_form[:name]}
              aria-label="Team name"
              autofocus
              class="mb-0 min-w-0 flex-1"
            />
            <div class="flex shrink-0 gap-2">
              <button
                type="submit"
                class="cursor-pointer rounded-full bg-ink-950 px-4 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-ink-800 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-red-500 focus-visible:ring-offset-2"
              >
                Save
              </button>
              <button
                type="button"
                phx-click="cancel_team_name_edit"
                class="cursor-pointer rounded-full border border-ink-300 bg-white px-4 py-2.5 text-sm font-semibold text-ink-700 transition-colors hover:bg-ink-100 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-red-500 focus-visible:ring-offset-2"
              >
                Cancel
              </button>
            </div>
          </div>
        </.form>
      <% else %>
        <div class="flex items-center gap-2">
          <h1 class="mb-0.5 text-2xl font-bold tracking-tight text-ink-950 sm:text-3xl">
            {@team.name}
          </h1>
          <button
            :if={@is_captain}
            type="button"
            phx-click="edit_team_name"
            aria-label="Edit team name"
            title="Edit team name"
            class="mt-0.5 inline-flex size-9 shrink-0 cursor-pointer items-center justify-center rounded-full text-ink-400 transition-colors hover:bg-red-50 hover:text-red-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-red-500 focus-visible:ring-offset-2"
          >
            <.icon name="hero-pencil" class="size-4.5" />
          </button>
        </div>
      <% end %>
      <div class="text-sm text-ink-500">
        {@team.region.name}
        <span :if={@is_captain} class="font-semibold text-red-700">· You are the Captain</span>
        <span :if={!@is_captain}>
          · You're a player · Captain is
          <span class="font-semibold text-ink-950">{@team.captain.username}</span>
        </span>
      </div>
    </div>
    <span class={[
      "shrink-0 rounded-full px-3.5 py-1.5 text-sm font-semibold",
      @eligible && "bg-green-100 text-green-600",
      !@eligible && "bg-red-50 text-red-700"
    ]}>
      {if @eligible,
        do: "● Eligible for draws",
        else: "● Needs #{@min_roster_size - @roster_count} more"}
    </span>
  </div>

  <PlayerComponents.card class="mb-5">
    <div class="mb-3 flex items-baseline justify-between">
      <div class="text-sm font-semibold text-ink-700">Roster size</div>
      <div class="font-mono text-sm text-ink-500">
        <span class="text-lg font-bold text-ink-950">{@roster_count}</span> / 8
      </div>
    </div>
    <div class="flex gap-1.5">
      <div
        :for={i <- 1..8}
        class={[
          "h-2 flex-1 rounded-full",
          i <= @roster_count && @eligible && "bg-ink-950",
          i <= @roster_count && !@eligible && "bg-red-500",
          i > @roster_count && "bg-ink-200"
        ]}
      >
      </div>
    </div>
    <p class="mt-3 text-[13px] text-ink-500">
      <%= if @eligible do %>
        Your team meets the 5–8 player requirement and is eligible for draws.
      <% else %>
        A team needs at least {@min_roster_size} players to be eligible for draws. Add {@min_roster_size -
          @roster_count} more.
      <% end %>
    </p>
  </PlayerComponents.card>

  <PlayerComponents.card :if={@is_captain} class="mb-5">
    <div class="mb-1 text-sm font-semibold text-ink-700">Invite a player</div>
    <p class="mb-3 text-[13px] text-ink-400">
      Invite any registered player, from any venue or region — they'll get a notification and
      have 48 hours to accept or decline.
    </p>
    <.form
      for={@add_form}
      id="add-player-form"
      phx-change="search_players"
      phx-submit="add_player"
      class="flex flex-wrap items-start gap-2.5"
    >
      <div class="relative min-w-[200px] flex-1">
        <PlayerComponents.input
          field={@add_form[:username]}
          id="player-search"
          placeholder="Search by name or username"
          autocomplete="off"
          phx-debounce="200"
          class="mb-0 rounded-full px-4 py-2.5 placeholder:text-ink-400"
        />
        <div
          :if={@player_suggestions != []}
          id="player-suggestions"
          class="absolute left-0 right-0 top-full z-20 mt-1 overflow-hidden rounded-xl border border-ink-200 bg-white py-1 shadow-lg"
        >
          <button
            :for={player <- @player_suggestions}
            id={"player-suggestion-#{player.id}"}
            type="button"
            phx-click="select_player"
            phx-value-username={player.username}
            class="flex w-full cursor-pointer flex-col px-4 py-2 text-left transition-colors hover:bg-ink-50 focus:bg-ink-50 focus:outline-none"
          >
            <span class="text-sm font-semibold text-ink-950">
              {player.first_name} {player.last_name}
            </span>
            <span class="font-mono text-xs text-ink-400">@{player.username}</span>
          </button>
        </div>
      </div>
      <PlayerComponents.button type="submit" variant="primary">Invite</PlayerComponents.button>
    </.form>

    <div :if={@sent_invitations != []} class="mt-4 border-t border-ink-100 pt-4">
      <div class="mb-2 text-[13px] font-semibold text-ink-700">Pending invitations</div>
      <div
        :for={invitation <- @sent_invitations}
        class="flex items-center gap-3 border-b border-ink-100 py-2 text-[13.5px] last:border-b-0"
      >
        <div class="min-w-0 flex-1 text-ink-700">
          @{invitation.player.username}
        </div>
        <button
          type="button"
          phx-click="cancel_invitation"
          phx-value-id={invitation.id}
          data-confirm="Cancel this invitation?"
          class="cursor-pointer rounded-lg px-2 py-1.5 text-[13px] font-semibold text-ink-400 hover:bg-red-50 hover:text-red-700"
        >
          Cancel
        </button>
      </div>
    </div>
  </PlayerComponents.card>

  <div class="overflow-hidden rounded-2xl border border-ink-200 bg-white shadow-sm">
    <div
      :for={player <- @team.roster}
      class="flex items-center gap-3.5 border-b border-ink-100 px-4 py-3.5 last:border-b-0"
    >
      <PlayerComponents.avatar name={"#{player.first_name} #{player.last_name}"} size="size-9" />
      <div class="min-w-0 flex-1">
        <div class="text-[15px] font-semibold text-ink-950">
          {player.first_name} {player.last_name}
        </div>
        <div class="font-mono text-[13px] text-ink-400">@{player.username}</div>
      </div>
      <PlayerComponents.badge :if={player.id == @team.captain_id} variant="danger">
        Captain
      </PlayerComponents.badge>
      <button
        :if={@is_captain and player.id != @team.captain_id}
        type="button"
        phx-click="remove_player"
        phx-value-id={player.id}
        data-confirm="Remove this player from the roster?"
        class="cursor-pointer rounded-lg px-2 py-1.5 text-[13px] font-semibold text-ink-400 hover:bg-red-50 hover:text-red-700"
      >
        Remove
      </button>
    </div>
  </div>

  <PlayerComponents.card :if={@is_captain} class="mt-5">
    <div class="mb-1 text-sm font-semibold text-red-700">Danger zone</div>
    <p class="mb-3 text-[13px] text-ink-400">
      Deleting the team removes every player from the roster and cancels any pending invitations.
      This can't be undone, and isn't possible once the team has been drawn into a stage.
    </p>
    <button
      type="button"
      phx-click="delete_team"
      data-confirm="Delete this team? This removes every player from the roster and cannot be undone."
      class="cursor-pointer rounded-full border border-red-200 bg-white px-4 py-2 text-[13px] font-semibold text-red-700 hover:bg-red-50"
    >
      Delete team
    </button>
  </PlayerComponents.card>
</PlayerComponents.app_shell>
