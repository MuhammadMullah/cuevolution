<h1 class="mb-1 text-xl font-bold tracking-tight text-ink-950">Your details</h1>
<p class="mb-5 text-sm text-ink-500">Players must be 18 or older and be a Kenyan citizen or a resident of Kenya for at least 5 years to register.</p>

<div class="mb-5 flex items-center gap-4">
  <label
    for={@uploads.photo.ref}
    class="flex size-16 shrink-0 cursor-pointer items-center justify-center overflow-hidden rounded-full border-2 border-dashed border-ink-300 bg-ink-50 text-xs font-semibold text-ink-400 hover:border-red-500"
  >
    <.live_img_preview
      :for={entry <- @uploads.photo.entries}
      entry={entry}
      class="size-full object-cover"
    />
    <span :if={@uploads.photo.entries == []} class="px-1 text-center leading-tight">
      Add photo
    </span>
  </label>
  <div>
    <div class="text-sm font-semibold text-ink-700">Profile picture</div>
    <div class="text-[13px] text-ink-400">Tap the circle to add a photo (optional)</div>
    <p
      :for={err <- upload_errors(@uploads.photo)}
      class="mt-1 text-[12.5px] font-medium text-danger"
    >
      {upload_error_message(err)}
    </p>
  </div>
</div>

<PlayerComponents.input field={@form[:first_name]} label="First name" placeholder="e.g. Brian" />
<PlayerComponents.input field={@form[:last_name]} label="Last name" placeholder="e.g. Otieno" />

<div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
  <PlayerComponents.input
    field={@form[:date_of_birth]}
    type="date"
    label="Date of birth"
    hint={age_hint(@attrs["date_of_birth"])}
    max={Date.to_iso8601(Date.utc_today())}
  />
  <PlayerComponents.input
    field={@form[:location]}
    label="Town / location"
    placeholder="e.g. Nairobi"
  />
</div>

<div class="mb-1.5 text-sm font-semibold text-ink-700">Category</div>
<div class="mb-4 flex gap-2.5">
  <PlayerComponents.option_pill
    :for={{label, value} <- @genders}
    selected={@attrs["gender"] == value}
    phx-click="choose"
    phx-value-field="gender"
    phx-value-choice={value}
  >
    {label}
  </PlayerComponents.option_pill>
</div>
<.field_error field={@form[:gender]} />
