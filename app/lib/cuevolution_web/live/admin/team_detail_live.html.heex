<AdminComponents.app_shell current_admin={@current_admin} active={:directory} flash={@flash}>
  <.link
    navigate={~p"/admin/players"}
    class="mb-4 inline-flex items-center gap-1.5 text-sm font-semibold text-ink-500 hover:text-ink-950"
  >
    ← Back to directory
  </.link>

  <.link
    navigate={~p"/admin/teams/new"}
    class="float-right -mt-1 rounded-full bg-ink-950 px-4 py-2 text-sm font-semibold text-white hover:bg-ink-800"
  >
    Create team
  </.link>

  <div class="mb-5 flex items-center gap-4 rounded-2xl bg-ink-950 px-6 py-6 text-white">
    <PlayerComponents.avatar name={@team.name} size="size-14" class="text-lg" />
    <div class="min-w-0 flex-1">
      <div class="text-[20px] font-bold tracking-tight">{@team.name}</div>
      <div class="text-sm text-ink-400">{@team.region.name}</div>
    </div>
    <span class={[
      "rounded-full px-2.5 py-1 text-xs font-semibold",
      @eligible && "bg-[#DCF3E4] text-[#0E6A30]",
      !@eligible && "bg-red-500/15 text-red-300"
    ]}>
      {if @eligible, do: "Eligible (5–8)", else: "Not eligible yet"}
    </span>
  </div>

  <AdminComponents.card class="mb-5">
    <div class="grid grid-cols-1 gap-x-5 sm:grid-cols-2">
      <div class="border-b border-ink-100 py-2.5">
        <div class="text-[11.5px] text-ink-400">Captain</div>
        <div class="text-sm font-semibold text-ink-950">
          {@team.captain.first_name} {@team.captain.last_name}
        </div>
      </div>
      <div class="border-b border-ink-100 py-2.5">
        <div class="text-[11.5px] text-ink-400">Roster size</div>
        <div class="text-sm font-semibold text-ink-950">{length(@team.roster)} / 8</div>
      </div>
    </div>
  </AdminComponents.card>

  <AdminComponents.card class="mb-5">
    <div class="mb-1 text-sm font-semibold text-ink-700">Add player directly</div>
    <p class="mb-3 text-[13px] text-ink-400">
      This assigns the player immediately and does not send an invitation.
    </p>
    <.form for={@add_form} id="admin-add-player-form" phx-submit="add_player">
      <div class="relative">
        <input
          id="admin-player-search"
          type="search"
          value={
            if @selected_player,
              do: "#{@selected_player.first_name} #{@selected_player.last_name}",
              else: ""
          }
          placeholder="Search by name or username"
          autocomplete="off"
          phx-keyup="search_players"
          phx-debounce="200"
          class="w-full rounded-lg border border-ink-300 bg-white px-3.5 py-2.5 text-sm text-ink-950 placeholder:text-ink-400 focus:border-red-500 focus:outline-none focus:ring-4 focus:ring-red-500/15"
        />
        <input
          :if={@selected_player}
          type="hidden"
          name="roster[player_id]"
          value={@selected_player.id}
        />
        <div
          :if={@player_suggestions != []}
          id="admin-player-suggestions"
          class="absolute left-0 right-0 top-full z-20 mt-1 overflow-hidden rounded-xl border border-ink-200 bg-white py-1 shadow-lg"
        >
          <button
            :for={player <- @player_suggestions}
            id={"admin-player-suggestion-#{player.id}"}
            type="button"
            phx-click="select_player"
            phx-value-id={player.id}
            class="flex w-full cursor-pointer flex-col px-4 py-2 text-left hover:bg-ink-50"
          >
            <span class="text-sm font-semibold text-ink-950">
              {player.first_name} {player.last_name}
            </span>
            <span class="font-mono text-xs text-ink-400">@{player.username}</span>
          </button>
        </div>
      </div>
      <button
        id="admin-add-player-button"
        type="submit"
        disabled={@selected_player == nil}
        class="mt-3 rounded-full bg-ink-950 px-4 py-2.5 text-sm font-semibold text-white hover:bg-ink-800 disabled:cursor-not-allowed disabled:opacity-50"
      >
        Add player directly
      </button>
    </.form>
  </AdminComponents.card>

  <h2 class="mb-3 text-[15px] font-bold tracking-tight text-ink-950">Roster</h2>
  <div
    :if={@team.roster != []}
    class="overflow-hidden rounded-2xl border border-ink-200 bg-white shadow-[0_1px_2px_rgba(13,12,34,0.05)]"
  >
    <.link
      :for={player <- @team.roster}
      navigate={~p"/admin/players/#{player.id}"}
      class="flex items-center justify-between gap-3 border-b border-ink-100 px-5 py-3 text-sm last:border-0 hover:bg-ink-50"
    >
      <span class="font-semibold text-ink-950">{player.first_name} {player.last_name}</span>
      <span class="text-ink-500">
        {if player.id == @team.captain_id, do: "Captain", else: "Player"}
      </span>
    </.link>
  </div>
  <div
    :if={@team.roster == []}
    class="rounded-2xl border border-ink-200 bg-white px-[22px] py-7 text-center text-sm text-ink-400 shadow-[0_1px_2px_rgba(13,12,34,0.05)]"
  >
    No players on this roster yet.
  </div>

  <AdminComponents.card class="mt-5">
    <div class="mb-1 text-sm font-semibold text-red-700">Danger zone</div>
    <p class="mb-3 text-[13px] text-ink-400">
      Deleting the team releases every player from its roster and cancels pending invitations.
      This isn't possible once the team has been drawn into a stage.
    </p>
    <button
      id="admin-delete-team-button"
      type="button"
      phx-click="delete_team"
      data-confirm="Delete this team? This releases every player and cannot be undone."
      class="cursor-pointer rounded-full border border-red-200 bg-white px-4 py-2 text-[13px] font-semibold text-red-700 hover:bg-red-50"
    >
      Delete team
    </button>
  </AdminComponents.card>
</AdminComponents.app_shell>
