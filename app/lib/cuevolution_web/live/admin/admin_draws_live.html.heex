<AdminComponents.app_shell current_admin={@current_admin} active={:draws} flash={@flash}>
  <div class="mb-5 flex flex-wrap items-end justify-between gap-3">
    <div>
      <AdminComponents.eyebrow class="mb-1.5">Draws</AdminComponents.eyebrow>
      <h1 class="text-[clamp(24px,4vw,30px)] font-bold tracking-tight text-ink-950">
        Fixture entry
      </h1>
    </div>
    <select
      disabled
      class="cursor-not-allowed rounded-full border border-ink-300 bg-ink-50 px-[15px] py-2.5 font-sans text-sm text-ink-400"
    >
      <option>No rounds scheduled yet</option>
    </select>
  </div>

  <form phx-change="update_rows" id="draws-form">
    <div class="mb-4 overflow-x-auto rounded-2xl border border-ink-200 bg-white shadow-[0_1px_2px_rgba(13,12,34,0.05)]">
      <table class="w-full min-w-[820px] border-collapse">
        <thead>
          <tr class="border-b border-ink-200 bg-ink-50">
            <th class="px-3.5 py-[11px] text-left text-[11px] font-semibold uppercase tracking-[0.06em] text-ink-500">
              Category
            </th>
            <th class="px-3.5 py-[11px] text-left text-[11px] font-semibold uppercase tracking-[0.06em] text-ink-500">
              Participant A
            </th>
            <th class="px-3.5 py-[11px] text-left text-[11px] font-semibold uppercase tracking-[0.06em] text-ink-500">
              Participant B
            </th>
            <th class="px-3.5 py-[11px] text-left text-[11px] font-semibold uppercase tracking-[0.06em] text-ink-500">
              Venue
            </th>
            <th class="px-3.5 py-[11px] text-left text-[11px] font-semibold uppercase tracking-[0.06em] text-ink-500">
              Date
            </th>
            <th class="px-3.5 py-[11px] text-left text-[11px] font-semibold uppercase tracking-[0.06em] text-ink-500">
              Time
            </th>
            <th class="w-10 px-3.5 py-[11px]"></th>
          </tr>
        </thead>
        <tbody>
          <tr :for={row <- @rows} class="border-b border-ink-100 last:border-0">
            <td class="p-2">
              <select
                name={"rows[#{row.id}][category]"}
                class="w-full rounded-lg border border-ink-300 bg-white px-2.5 py-2 text-[13.5px]"
              >
                <option
                  :for={{label, value} <- @categories}
                  value={value}
                  selected={value == row.category}
                >
                  {label}
                </option>
              </select>
            </td>
            <td class="p-2">
              <input
                type="text"
                name={"rows[#{row.id}][a]"}
                value={row.a}
                placeholder="Search name…"
                class="w-full rounded-lg border border-ink-300 px-2.5 py-2 text-[13.5px] focus:border-red-500 focus:outline-none"
              />
            </td>
            <td class="p-2">
              <input
                type="text"
                name={"rows[#{row.id}][b]"}
                value={row.b}
                placeholder="Search name…"
                class="w-full rounded-lg border border-ink-300 px-2.5 py-2 text-[13.5px] focus:border-red-500 focus:outline-none"
              />
            </td>
            <td class="p-2">
              <select
                name={"rows[#{row.id}][venue_id]"}
                class="w-full rounded-lg border border-ink-300 bg-white px-2.5 py-2 text-[13.5px]"
              >
                <option value="">Select venue…</option>
                <option
                  :for={venue <- @venues}
                  value={venue.id}
                  selected={venue.id == row.venue_id}
                >
                  {venue.name}
                </option>
              </select>
            </td>
            <td class="p-2">
              <input
                type="date"
                name={"rows[#{row.id}][date]"}
                value={row.date}
                class="w-full rounded-lg border border-ink-300 px-2.5 py-2 text-[13px]"
              />
            </td>
            <td class="p-2">
              <input
                type="time"
                name={"rows[#{row.id}][time]"}
                value={row.time}
                class="w-full rounded-lg border border-ink-300 px-2.5 py-2 text-[13px]"
              />
            </td>
            <td class="p-2 text-center">
              <button
                type="button"
                phx-click="remove_row"
                phx-value-id={row.id}
                class="rounded-md p-1.5 text-ink-400 hover:bg-red-50 hover:text-red-700"
              >
                ✕
              </button>
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  </form>

  <div class="mb-9 flex flex-wrap items-center justify-between gap-2.5">
    <button
      type="button"
      phx-click="add_row"
      class="rounded-full border border-ink-300 bg-white px-[18px] py-2.5 text-sm font-semibold text-ink-700 hover:bg-ink-50"
    >
      + Add row
    </button>
    <button
      type="button"
      phx-click="save"
      class="rounded-full bg-ink-950 px-[26px] py-2.5 text-sm font-semibold text-white hover:bg-ink-900"
    >
      Save round &amp; notify players
    </button>
  </div>

  <h2 class="mb-3 text-[15px] font-bold tracking-tight text-ink-950">Already entered</h2>
  <div class="rounded-2xl border border-ink-200 bg-white px-[22px] py-[30px] text-center text-sm text-ink-400 shadow-[0_1px_2px_rgba(13,12,34,0.05)]">
    No fixtures entered for this round yet — add rows above and save.
  </div>
</AdminComponents.app_shell>
