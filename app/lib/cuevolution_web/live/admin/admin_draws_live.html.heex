<AdminComponents.app_shell current_admin={@current_admin} active={:draws} flash={@flash}>
  <div class="mb-5 flex flex-wrap items-end justify-between gap-3">
    <div>
      <AdminComponents.eyebrow class="mb-1.5">Draws</AdminComponents.eyebrow>
      <h1 class="text-[clamp(24px,4vw,30px)] font-bold tracking-tight text-ink-950">
        Fixture entry
      </h1>
    </div>

    <div class="flex flex-wrap gap-2.5">
      <form phx-change="select_round">
        <select
          name="id"
          class="cursor-pointer rounded-lg border border-ink-300 bg-white px-3.5 py-2.5 font-sans text-sm text-ink-950"
        >
          <option value="" selected={is_nil(@round)}>Select a round…</option>
          <option
            :for={round <- @rounds}
            value={round.id}
            selected={@round && @round.id == round.id}
          >
            {round_label(round)}
          </option>
        </select>
      </form>
      <span :if={@rounds == []} class="self-center text-[13.5px] text-ink-400">
        No rounds scheduled yet.
      </span>

      <button
        type="button"
        phx-click="toggle_new_round"
        class="rounded-full border border-ink-300 bg-white px-4 py-2.5 text-sm font-semibold text-ink-700 hover:bg-ink-50"
      >
        + New round
      </button>
    </div>
  </div>

  <div
    :if={@show_new_round}
    class="mb-5 rounded-2xl border border-ink-200 bg-white px-5 py-[18px] shadow-[0_1px_2px_rgba(13,12,34,0.05)]"
  >
    <div class="mb-3 flex flex-wrap gap-2.5">
      <form phx-change="select_new_round_stage">
        <select
          name="id"
          class="cursor-pointer rounded-lg border border-ink-300 bg-white px-[13px] py-2 font-sans text-[13px] text-ink-950"
        >
          <option
            :for={stage <- @stages}
            value={stage.id}
            selected={@new_round_stage.id == stage.id}
          >
            {stage.name}
          </option>
        </select>
      </form>
      <select
        :if={group_stage?(@new_round_stage)}
        name="round[group_id]"
        form="new-round-form"
        class="min-w-[220px] flex-1 cursor-pointer rounded-lg border border-ink-300 bg-white px-[13px] py-2 font-sans text-[13px] text-ink-950"
      >
        <option value="">Select a group…</option>
        <option :for={group <- @round_groups} value={group.id}>
          {group.name} · {if group.venue_id, do: group.venue.name, else: group.region.name} · {group.category}
        </option>
      </select>
      <select
        :if={!group_stage?(@new_round_stage)}
        name="round[category]"
        form="new-round-form"
        class="cursor-pointer rounded-lg border border-ink-300 bg-white px-[13px] py-2 font-sans text-[13px] text-ink-950"
      >
        <option :for={{label, value} <- @categories} value={value}>{label}</option>
      </select>
    </div>
    <.form
      id="new-round-form"
      for={@new_round_form}
      phx-submit="create_round"
      class="flex flex-wrap items-center gap-2.5"
    >
      <div class="min-w-[200px] flex-1">
        <.input
          field={@new_round_form[:name]}
          placeholder={
            if group_stage?(@new_round_stage), do: "e.g. Round 4", else: "Round of 64…"
          }
          class="w-full rounded-lg border border-ink-300 bg-white px-[13px] py-2.5 font-sans text-[14px] text-ink-950 placeholder:text-ink-400 focus:border-red-500 focus:outline-none"
        />
      </div>
      <button
        type="submit"
        class="shrink-0 rounded-full bg-ink-950 px-[22px] py-2.5 text-[14px] font-semibold text-white hover:bg-ink-900"
      >
        Create round
      </button>
    </.form>
  </div>

  <form phx-change="update_rows" phx-submit="noop" id="draws-form">
    <div class="mb-4 overflow-x-auto rounded-2xl border border-ink-200 bg-white shadow-[0_1px_2px_rgba(13,12,34,0.05)]">
      <table class="w-full min-w-[820px] border-collapse">
        <thead>
          <tr class="border-b border-ink-200 bg-ink-50">
            <th class="px-3.5 py-[11px] text-left text-[11px] font-semibold uppercase tracking-[0.06em] text-ink-500">
              Category
            </th>
            <th class="px-3.5 py-[11px] text-left text-[11px] font-semibold uppercase tracking-[0.06em] text-ink-500">
              Participant A
            </th>
            <th class="px-3.5 py-[11px] text-left text-[11px] font-semibold uppercase tracking-[0.06em] text-ink-500">
              Participant B
            </th>
            <th class="px-3.5 py-[11px] text-left text-[11px] font-semibold uppercase tracking-[0.06em] text-ink-500">
              Venue
            </th>
            <th class="px-3.5 py-[11px] text-left text-[11px] font-semibold uppercase tracking-[0.06em] text-ink-500">
              Date
            </th>
            <th class="px-3.5 py-[11px] text-left text-[11px] font-semibold uppercase tracking-[0.06em] text-ink-500">
              Time
            </th>
            <th class="w-10 px-3.5 py-[11px]"></th>
          </tr>
        </thead>
        <tbody>
          <%= for row <- @rows do %>
            <tr class="border-b border-ink-100 last:border-0">
              <td class="p-2">
                <select
                  name={"rows[#{row.id}][category]"}
                  class="w-full rounded-lg border border-ink-300 bg-white px-2.5 py-2 text-[13.5px] text-ink-950"
                >
                  <option
                    :for={{label, value} <- @categories}
                    value={value}
                    selected={value == row.category}
                  >
                    {label}
                  </option>
                </select>
              </td>
              <td class="p-2 align-top">
                <AdminComponents.field_search
                  row_id={row.id}
                  field="a"
                  value={row.a}
                  confirmed={!!row.a_id}
                  placeholder="Search name…"
                  suggestions={row.a_suggestions}
                />
              </td>
              <td class="p-2 align-top">
                <AdminComponents.field_search
                  row_id={row.id}
                  field="b"
                  value={row.b}
                  confirmed={!!row.b_id}
                  placeholder="Search name…"
                  suggestions={row.b_suggestions}
                />
              </td>
              <td class="p-2 align-top">
                <AdminComponents.field_search
                  row_id={row.id}
                  field="venue"
                  value={row.venue}
                  confirmed={!!row.venue_id}
                  placeholder="Search venue…"
                  suggestions={row.venue_suggestions}
                />
              </td>
              <td class="p-2">
                <AdminComponents.date_field
                  id={"row-#{row.id}-date"}
                  name={"rows[#{row.id}][date]"}
                  value={row.date}
                />
              </td>
              <td class="p-2">
                <AdminComponents.time_select
                  id={"row-#{row.id}-time"}
                  name={"rows[#{row.id}][time]"}
                  value={row.time}
                />
              </td>
              <td class="p-2 text-center">
                <button
                  type="button"
                  phx-click="remove_row"
                  phx-value-id={row.id}
                  class="rounded-md p-1.5 text-ink-400 hover:bg-red-50 hover:text-red-700"
                >
                  ✕
                </button>
              </td>
            </tr>
            <tr :if={row.error} class="border-b border-ink-100 bg-red-50 last:border-0">
              <td colspan="7" class="px-3.5 py-1.5 text-[12.5px] text-red-700">{row.error}</td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </form>

  <div class="mb-9 flex flex-wrap items-center justify-between gap-2.5">
    <button
      type="button"
      phx-click="add_row"
      class="rounded-full border border-ink-300 bg-white px-[18px] py-2.5 text-sm font-semibold text-ink-700 hover:bg-ink-50"
    >
      + Add row
    </button>
    <button
      type="button"
      phx-click="save"
      class="rounded-full bg-ink-950 px-[26px] py-2.5 text-sm font-semibold text-white hover:bg-ink-900"
    >
      Save round &amp; notify players
    </button>
  </div>

  <h2 class="mb-3 text-[15px] font-bold tracking-tight text-ink-950">Already entered</h2>
  <div
    id="entered-fixtures"
    phx-update="stream"
    class={[
      "overflow-hidden rounded-2xl border border-ink-200 bg-white shadow-[0_1px_2px_rgba(13,12,34,0.05)]",
      !@has_entered_fixtures && "hidden"
    ]}
  >
    <div
      :for={{dom_id, fixture} <- @streams.entered_fixtures}
      id={dom_id}
      class="flex flex-wrap items-center gap-3.5 border-b border-ink-100 px-4.5 py-3.5 last:border-0"
    >
      <div class="min-w-[200px] flex-1">
        <div class="text-[14.5px] font-semibold text-ink-950">
          {Competitions.participant_name(fixture.participant_a)} vs {Competitions.participant_name(
            fixture.participant_b
          )}
        </div>
        <div class="text-[12.5px] text-ink-400">
          {fixture.venue.name} · {fixture_time_label(fixture)}
        </div>
      </div>
      <span class="rounded-full bg-ink-100 px-2.5 py-1 text-xs font-semibold text-ink-700">
        Unplayed
      </span>
    </div>
  </div>
  <div
    :if={!@has_entered_fixtures}
    class="rounded-2xl border border-ink-200 bg-white px-[22px] py-[30px] text-center text-sm text-ink-400 shadow-[0_1px_2px_rgba(13,12,34,0.05)]"
  >
    No fixtures entered for this round yet — add rows above and save.
  </div>
</AdminComponents.app_shell>
