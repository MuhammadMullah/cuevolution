<AdminComponents.guest_shell flash={@flash}>
  <div :if={@stage == :request}>
    <div class="mb-2.5 font-mono text-[11px] font-medium uppercase tracking-[0.14em] text-red-300">
      Circuit Admin
    </div>
    <h1 class="mb-1.5 text-2xl font-bold tracking-tight text-ink-25">Forgot your password?</h1>
    <p class="mb-6 text-sm leading-relaxed text-ink-400">
      Enter the email on your admin account and we'll send a link to reset it.
    </p>

    <.form for={@form} phx-submit="send_reset">
      <div class="mb-4">
        <label for={@form[:email].id} class="mb-1.5 block text-[13px] font-semibold text-ink-300">
          Email
        </label>
        <input
          type="email"
          name={@form[:email].name}
          id={@form[:email].id}
          value={@form[:email].value}
          placeholder="admin@sportpesapool.ke"
          required
          class="w-full rounded-[10px] border border-[#33324a] bg-ink-950 px-3.5 py-[11px] text-[15px] text-ink-25 placeholder:text-ink-500 focus:border-red-500 focus:outline-none focus:ring-[3px] focus:ring-red-500/20"
        />
      </div>

      <div
        :if={@error}
        class="mb-3.5 rounded-[10px] border border-red-500/30 bg-red-500/15 px-3 py-2.5 text-[13px] font-medium text-red-300"
      >
        {@error}
      </div>

      <button
        type="submit"
        class="mt-2 w-full cursor-pointer rounded-full bg-red-500 px-6 py-[13px] text-[15px] font-semibold text-white hover:bg-red-600"
      >
        Send reset link
      </button>
    </.form>

    <p class="mt-4.5 text-center text-[12.5px] text-ink-500">
      <.link navigate={~p"/admin/login"} class="font-semibold text-red-300 hover:text-red-200">
        Back to sign in
      </.link>
    </p>
  </div>

  <div :if={@stage == :sent} class="text-center">
    <div class="mx-auto mb-4.5 flex size-[52px] items-center justify-center rounded-full bg-red-500/15 text-2xl text-red-300">
      ✉
    </div>
    <h1 class="mb-2 text-xl font-bold tracking-tight text-ink-25">Check your email</h1>
    <p class="mb-2 text-[15px] leading-relaxed text-ink-400">
      If <strong class="text-ink-200">{@email}</strong> matches an admin account, we've sent a
      password reset link to it. Click the link to choose a new password — it expires in 20
      minutes.
    </p>
    <p class="mt-5 text-center text-[12.5px] text-ink-500">
      Didn't get it?
      <a href="#" phx-click="resend" class="font-semibold text-red-300 hover:text-red-200">
        Resend email
      </a>
      ·
      <.link navigate={~p"/admin/login"} class="font-semibold text-red-300 hover:text-red-200">
        Back to sign in
      </.link>
    </p>
  </div>
</AdminComponents.guest_shell>
