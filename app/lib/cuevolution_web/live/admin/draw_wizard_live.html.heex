<AdminComponents.app_shell current_admin={@current_admin} active={:draws} flash={@flash}>
  <div class="mx-auto max-w-5xl">
    <div class="mb-8 flex flex-wrap items-end justify-between gap-4">
      <div>
        <AdminComponents.eyebrow class="mb-2">Grassroots draw wizard</AdminComponents.eyebrow>
        <h1 class="text-[clamp(26px,4vw,38px)] font-bold tracking-tight text-ink-950">
          Run a draw
        </h1>
        <p class="mt-2 max-w-2xl text-sm leading-6 text-ink-500">
          Build a balanced individual draw, preview the seeded groups, then approve and publish the fixtures.
        </p>
      </div>
      <.link
        navigate={~p"/admin/groups"}
        class="rounded-full border border-ink-300 px-4 py-2 text-sm font-semibold text-ink-700 hover:bg-ink-50"
      >
        Back to groups
      </.link>
    </div>

    <section class="rounded-2xl border border-ink-200 bg-white p-5 shadow-[0_1px_2px_rgba(13,12,34,0.05)] sm:p-7">
      <div class="mb-5 flex items-center gap-2 text-xs font-semibold uppercase tracking-[0.12em] text-ink-400">
        <span class={[
          "rounded-full px-3 py-1",
          is_nil(@draw) && "bg-red-100 text-red-700",
          !is_nil(@draw) && "bg-green-100 text-green-700"
        ]}>
          1 · Configure
        </span>
        <span class="text-ink-300">→</span>
        <span class={[
          "rounded-full px-3 py-1",
          @draw && @draw.state == "previewed" && "bg-red-100 text-red-700"
        ]}>
          2 · Preview
        </span>
        <span class="text-ink-300">→</span>
        <span class="rounded-full px-3 py-1">3 · Publish</span>
      </div>

      <.form
        :if={is_nil(@draw)}
        for={@form}
        id="draw-wizard-form"
        phx-submit="propose"
        class="grid gap-4 sm:grid-cols-3"
      >
        <.input
          field={@form[:stage_id]}
          type="select"
          label="Stage"
          options={Enum.map(@stages, &{&1.name, &1.id})}
          prompt="Choose stage"
        />
        <.input
          field={@form[:venue_id]}
          type="select"
          label="Venue"
          options={Enum.map(@venues, &{&1.name, &1.id})}
          prompt="Choose venue"
        />
        <.input
          field={@form[:category]}
          type="select"
          label="Category"
          options={@categories}
          prompt="Choose category"
        />
        <div class="sm:col-span-3 flex justify-end">
          <button
            class="rounded-full bg-ink-950 px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-ink-800"
            type="submit"
          >
            Propose draw
          </button>
        </div>
      </.form>

      <div
        :if={@proposal && is_nil(@draw)}
        class="mt-6 rounded-xl border border-green-200 bg-green-50 p-5"
      >
        <div class="flex flex-wrap items-start justify-between gap-4">
          <div>
            <p class="text-sm font-bold text-green-950">Formula preview</p>
            <p class="mt-1 text-sm text-green-800">
              {@proposal.entrant_count} entrants → {@proposal.group_count} groups
            </p>
          </div>
          <div class="text-right text-xs font-medium text-green-800">
            Group sizes: {Enum.join(Enum.map(@proposal.sizes, &to_string/1), " + ")}
          </div>
        </div>
        <.form
          for={@form}
          id="create-draw-form"
          phx-submit="create_draw"
          class="mt-5 flex flex-wrap items-end gap-3"
        >
          <.input
            field={@form[:group_count]}
            type="number"
            label="Override group count (optional)"
            min="1"
            class="w-56 rounded-lg border border-green-300 bg-white px-3 py-2 text-sm"
          />
          <button
            class="rounded-full bg-green-700 px-5 py-2.5 text-sm font-semibold text-white hover:bg-green-800"
            type="submit"
          >
            Deal draw
          </button>
        </.form>
      </div>
    </section>

    <section
      :if={@draw}
      class="mt-5 rounded-2xl border border-ink-200 bg-white p-5 shadow-[0_1px_2px_rgba(13,12,34,0.05)] sm:p-7"
    >
      <div class="flex flex-wrap items-center justify-between gap-3">
        <div>
          <p class="text-xs font-semibold uppercase tracking-[0.12em] text-ink-400">
            Draw status
          </p>
          <p class="mt-1 text-2xl font-bold capitalize text-ink-950">{@draw.state}</p>
        </div>
        <div class="flex flex-wrap gap-2">
          <button
            :if={@draw.state == "previewed"}
            phx-click="advance"
            phx-value-state="approved"
            class="rounded-full bg-ink-950 px-4 py-2 text-sm font-semibold text-white hover:bg-ink-800"
          >
            Approve draw
          </button>
          <button
            :if={@draw.state == "approved"}
            phx-click="advance"
            phx-value-state="published"
            class="rounded-full bg-red-600 px-4 py-2 text-sm font-semibold text-white hover:bg-red-700"
          >
            Publish & generate fixtures
          </button>
        </div>
      </div>

      <div class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        <article :for={group <- @groups} class="rounded-xl border border-ink-200 bg-ink-25 p-4">
          <div class="flex items-center justify-between">
            <h2 class="font-bold text-ink-950">{group.name}</h2>
            <span class="rounded-full bg-white px-2 py-1 text-xs font-semibold text-ink-500">
              {length(group.group_memberships)}
            </span>
          </div>
          <ul class="mt-3 space-y-1.5 text-sm text-ink-700">
            <li :for={membership <- group.group_memberships}>
              {Competitions.participant_name(membership.stage_participation)}
            </li>
          </ul>
        </article>
      </div>

      <div
        :if={@draw.state == "published"}
        class="mt-6 rounded-xl bg-green-50 p-4 text-sm font-medium text-green-800"
      >
        Published. Fixtures have been generated and player notifications queued.
      </div>

      <.form
        :if={@draw.state == "published"}
        for={to_form(%{}, as: :redraw)}
        id="redraw-form"
        phx-submit="redraw"
        class="mt-6 flex flex-wrap items-end gap-3 border-t border-ink-100 pt-5"
      >
        <.input
          field={to_form(%{}, as: :redraw)[:reason]}
          name="reason"
          type="text"
          label="Redraw reason"
          placeholder="Explain why this draw must be replaced"
          class="min-w-[280px] flex-1 rounded-lg border border-ink-300 px-3 py-2 text-sm"
        />
        <button
          class="rounded-full border border-red-300 px-4 py-2 text-sm font-semibold text-red-700 hover:bg-red-50"
          type="submit"
        >
          Create redraw
        </button>
      </.form>
    </section>
  </div>
</AdminComponents.app_shell>
