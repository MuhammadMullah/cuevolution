<AdminComponents.app_shell current_admin={@current_admin} active={:directory} flash={@flash}>
  <.link
    navigate={~p"/admin/players"}
    class="mb-4 inline-flex items-center gap-1.5 text-sm font-semibold text-ink-500 hover:text-ink-950"
  >
    ← Back to directory
  </.link>

  <div class="mb-5 flex items-center gap-4 rounded-2xl bg-ink-950 px-6 py-6 text-white">
    <PlayerComponents.avatar
      name={"#{@player.first_name} #{@player.last_name}"}
      src={ProfilePicture.url(@player.profile_picture_path)}
      size="size-14"
      class="text-lg"
    />
    <div class="min-w-0 flex-1">
      <div class="text-[20px] font-bold tracking-tight">
        {@player.first_name} {@player.last_name}
        <span :if={@player.anonymized_at} class="ml-1.5 text-[11.5px] font-semibold text-ink-400">
          ANONYMIZED
        </span>
      </div>
      <div class="text-sm text-ink-400">@{@player.username} · {@player.region.name}</div>
    </div>
  </div>

  <AdminComponents.card class="mb-5">
    <div class="grid grid-cols-1 gap-x-5 sm:grid-cols-2">
      <div
        :for={{label, value} <- player_fields(@player)}
        class="border-b border-ink-100 py-2.5 last:border-0"
      >
        <div class="text-[11.5px] text-ink-400">{label}</div>
        <div class="text-sm font-semibold text-ink-950">{value}</div>
      </div>
    </div>

    <div :if={is_nil(@player.anonymized_at) and is_nil(@anonymize_warnings)} class="mt-4">
      <button
        type="button"
        phx-click="confirm_anonymize"
        class="w-full rounded-full border border-red-300 bg-white px-[22px] py-3 text-[14.5px] font-semibold text-red-700 hover:bg-red-50"
      >
        Anonymize this record
      </button>
    </div>

    <div
      :if={@anonymize_warnings}
      class="mt-4 rounded-xl border border-amber-200 bg-amber-50 px-[15px] py-[13px]"
    >
      <div :if={@anonymize_warnings != []}>
        <div class="mb-1.5 text-[13px] font-bold text-amber-900">
          Before you anonymize:
        </div>
        <ul class="mb-0 list-disc pl-[18px] text-[13px] leading-relaxed text-amber-800">
          <li :if={:captain in @anonymize_warnings}>
            This player is a team captain — anonymizing them does not reassign the captaincy.
          </li>
          <li :if={:pending_fixtures in @anonymize_warnings}>
            This player has a fixture with no result recorded yet.
          </li>
        </ul>
      </div>
      <p :if={@anonymize_warnings == []} class="m-0 text-[13px] leading-relaxed text-amber-800">
        This will permanently remove {@player.first_name} {@player.last_name}'s personal details. Historical results and points remain intact.
      </p>
      <div class="mt-3 flex gap-2">
        <button
          type="button"
          phx-click="anonymize"
          class="rounded-full bg-red-600 px-4 py-2 text-[13px] font-semibold text-white hover:bg-red-700"
        >
          Yes, anonymize
        </button>
        <button
          type="button"
          phx-click="cancel_anonymize"
          class="rounded-full border border-ink-300 px-4 py-2 text-[13px] font-semibold text-ink-700 hover:bg-ink-50"
        >
          Cancel
        </button>
      </div>
    </div>
  </AdminComponents.card>

  <h2 class="mb-3 text-[15px] font-bold tracking-tight text-ink-950">
    Notification delivery history
  </h2>
  <div
    :if={@notifications != []}
    class="overflow-hidden rounded-2xl border border-ink-200 bg-white shadow-[0_1px_2px_rgba(13,12,34,0.05)]"
  >
    <div
      :for={n <- @notifications}
      class="flex flex-wrap items-center justify-between gap-3 border-b border-ink-100 px-5 py-3 text-sm last:border-0"
    >
      <span class="font-semibold text-ink-950">
        {n.event_type} <span class="font-normal text-ink-500">· {n.channel}</span>
      </span>
      <span class="font-mono text-xs text-ink-500">{n.status} · {n.updated_at}</span>
    </div>
  </div>
  <div
    :if={@notifications == []}
    class="rounded-2xl border border-ink-200 bg-white px-[22px] py-7 text-center text-sm text-ink-400 shadow-[0_1px_2px_rgba(13,12,34,0.05)]"
  >
    No notifications sent yet.
  </div>
</AdminComponents.app_shell>
