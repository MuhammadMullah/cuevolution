<AdminComponents.app_shell current_admin={@current_admin} active={:standings} flash={@flash}>
  <AdminComponents.eyebrow class="mb-1.5">Rankings</AdminComponents.eyebrow>
  <h1 class="mb-[18px] text-[clamp(24px,4vw,30px)] font-bold tracking-tight text-ink-950">
    Player standings
  </h1>

  <div class="mb-5 flex gap-5 overflow-x-auto border-b border-ink-200">
    <button
      :for={{slug, label} <- @categories}
      type="button"
      phx-click="category"
      phx-value-category={slug}
      class={[
        "whitespace-nowrap border-b-2 px-0.5 pb-2.5 text-[14px] font-semibold",
        @category == slug && "border-red-500 text-ink-950",
        @category != slug && "border-transparent text-ink-500 hover:text-ink-950"
      ]}
    >
      {label}
    </button>
  </div>

  <div
    :if={@rows == []}
    class="rounded-2xl border border-ink-200 bg-white px-[22px] py-6 text-center text-[13.5px] text-ink-400 shadow-[0_1px_2px_rgba(13,12,34,0.05)]"
  >
    No standings yet. They build up as results are recorded.
  </div>

  <div
    :if={@rows != []}
    class="overflow-x-auto rounded-2xl border border-ink-200 bg-white shadow-[0_1px_2px_rgba(13,12,34,0.05)]"
  >
    <table class="w-full min-w-[820px] border-collapse">
      <thead>
        <tr>
          <th
            :for={{key, short, full, align} <- columns()}
            scope="col"
            title={full}
            class={[
              "sticky top-0 whitespace-nowrap bg-ink-50 px-4 py-3 text-[11px] font-semibold uppercase tracking-wide",
              align,
              @sort_by == key && "text-ink-950",
              @sort_by != key && "text-ink-500"
            ]}
          >
            <button
              type="button"
              phx-click="sort"
              phx-value-by={key}
              class="inline-flex items-center gap-1 hover:text-ink-950"
            >
              {short}
              <span :if={@sort_by == key} aria-hidden="true">
                {if @sort_dir == :asc, do: "▲", else: "▼"}
              </span>
            </button>
          </th>
        </tr>
      </thead>

      <tbody>
        <tr
          :for={row <- @rows}
          class="border-t border-ink-100 hover:bg-ink-25"
        >
          <td
            :for={{key, _short, _full, align} <- columns()}
            class={[
              "whitespace-nowrap px-4 py-2.5 text-[14px]",
              align,
              key in ~w(rank) && "tabular-nums text-ink-400",
              key == "name" && "font-medium text-ink-950",
              key == "sp_points" && "font-bold tabular-nums text-ink-950",
              key not in ~w(rank name sp_points) && "tabular-nums text-ink-600"
            ]}
          >
            {cell(row, key)}
          </td>
        </tr>
      </tbody>
    </table>
  </div>

  <p :if={@rows != []} class="mt-3 text-[12px] leading-relaxed text-ink-400">
    Ranked on SP Points first, then match difference, then frame difference, then frames won.
    Sorting a column is a view of the same table — the rank stays as published. Updates as
    results are recorded.
  </p>
</AdminComponents.app_shell>
