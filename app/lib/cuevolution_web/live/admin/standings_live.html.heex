<AdminComponents.app_shell current_admin={@current_admin} active={:standings} flash={@flash}>
  <AdminComponents.eyebrow class="mb-1.5">Rankings</AdminComponents.eyebrow>

  <div class="mb-[18px] flex flex-wrap items-center gap-3">
    <h1 class="text-[clamp(24px,4vw,30px)] font-bold tracking-tight text-ink-950">
      Player standings
    </h1>
    <span class={[
      "inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 text-[11px] font-bold uppercase tracking-[0.06em]",
      @state == :final && "bg-ink-950 text-white",
      @state == :provisional && "bg-amber-50 text-amber-700"
    ]}>
      {if @state == :final, do: "Final", else: "Provisional"}
    </span>
  </div>

  <div class="mb-5 flex flex-wrap gap-x-5 gap-y-1 border-b border-ink-200 sm:flex-nowrap sm:overflow-x-auto">
    <button
      :for={{slug, label} <- @categories}
      type="button"
      phx-click="category"
      phx-value-category={slug}
      class={[
        "min-h-11 whitespace-nowrap border-b-2 px-0.5 pb-2.5 sm:min-h-0 text-[14px] font-semibold",
        @category == slug && "border-red-500 text-ink-950",
        @category != slug && "border-transparent text-ink-500 hover:text-ink-950"
      ]}
    >
      {label}
    </button>
  </div>

  <div
    :if={@rows == []}
    class="rounded-2xl border border-ink-200 bg-white px-[22px] py-6 text-center text-[13.5px] text-ink-400 shadow-[0_1px_2px_rgba(13,12,34,0.05)]"
  >
    No standings yet. They build up as results are recorded.
  </div>

  <div
    :if={@rows != []}
    class="overflow-x-auto rounded-2xl border border-ink-200 bg-white shadow-[0_1px_2px_rgba(13,12,34,0.05)]"
  >
    <table class="table-stack w-full border-collapse sm:min-w-[1180px]">
      <thead>
        <tr>
          <th
            :for={{short, full, align} <- columns(@state)}
            scope="col"
            title={full}
            class={[
              "sticky top-0 whitespace-nowrap bg-ink-50 px-4 py-3 text-[11px] font-semibold uppercase tracking-wide text-ink-500",
              align
            ]}
          >
            {short}
          </th>
        </tr>
      </thead>

      <tbody>
        <tr
          :for={row <- @rows}
          class={[
            "border-t border-ink-100 hover:bg-ink-25",
            row.finish == :champion && "bg-gold-50/50"
          ]}
        >
          <td
            :for={{short, _full, align} <- columns(@state)}
            data-label={short}
            class={[
              "whitespace-nowrap px-4 py-2.5 text-[14px]",
              align,
              short == "Player" && "font-medium text-ink-950",
              short == "SP Points" && "font-bold tabular-nums text-ink-950",
              short == "Pos" && "tabular-nums text-ink-400",
              short not in ["Player", "SP Points", "Pos", "Region", "Status", "Finish"] &&
                "tabular-nums text-ink-600",
              short in ["Region", "Status", "Finish"] && "text-ink-600"
            ]}
          >
            {cell(row, short, @state)}
          </td>
        </tr>
      </tbody>
    </table>
  </div>

  <p :if={@rows != []} class="mt-3 text-[12px] leading-relaxed text-ink-400">
    Ranked on SP Points, then frame-win %. Players knocked out at the same stage share a position,
    shown as <span class="font-mono">3=</span>, and share their points — frame-win % only orders
    the rows inside a shared position, it never moves anyone up or down it. MP, MW and ML include
    walkovers and byes; the frame columns leave them out, so a player's frames are the ones they
    actually played.
    <span :if={@state == :provisional}>
      This table is provisional while the circuit is running: each player is scored on the stage
      they have reached so far.
    </span>
    <span :if={@state == :final}>This circuit is over and the table is final.</span>
  </p>
</AdminComponents.app_shell>
