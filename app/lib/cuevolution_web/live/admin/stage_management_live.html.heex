<AdminComponents.app_shell current_admin={@current_admin} active={:stages} flash={@flash}>
  <AdminComponents.eyebrow class="mb-1.5">Qualification Pipeline</AdminComponents.eyebrow>
  <h1 class="mb-[18px] text-[clamp(24px,4vw,30px)] font-bold tracking-tight text-ink-950">
    Stages
  </h1>

  <div class="mb-3.5 flex gap-2 overflow-x-auto">
    <button
      :for={stage <- @stages}
      type="button"
      phx-click="select_stage"
      phx-value-id={stage.id}
      class={[
        "whitespace-nowrap rounded-full border px-4 py-[9px] text-[13.5px] font-semibold",
        @stage.id == stage.id && stage_tab_active_class(stage.name),
        @stage.id != stage.id && "border-ink-300 bg-white text-ink-700 hover:bg-ink-50"
      ]}
    >
      {stage.name}
    </button>
  </div>

  <div class="mb-5 flex gap-5 border-b border-ink-200">
    <button
      type="button"
      phx-click="switch_panel"
      phx-value-panel="participants"
      class={[
        "whitespace-nowrap border-b-2 px-0.5 pb-2.5 text-[14px] font-semibold",
        @panel == :participants && "border-red-500 text-ink-950",
        @panel != :participants && "border-transparent text-ink-500 hover:text-ink-950"
      ]}
    >
      Participants
    </button>
    <button
      type="button"
      phx-click="switch_panel"
      phx-value-panel="capacity"
      class={[
        "whitespace-nowrap border-b-2 px-0.5 pb-2.5 text-[14px] font-semibold",
        @panel == :capacity && "border-red-500 text-ink-950",
        @panel != :capacity && "border-transparent text-ink-500 hover:text-ink-950"
      ]}
    >
      {if @stage.name in ["Circuit", "Finals"], do: "Capacity", else: "Group settings"}
    </button>
  </div>

  <div
    :if={@stage.name == "Grassroots"}
    class="mb-4.5 flex flex-wrap items-center gap-2.5 rounded-2xl border border-ink-200 bg-white px-[18px] py-3.5 shadow-[0_1px_2px_rgba(13,12,34,0.05)]"
  >
    <span class="text-sm font-semibold text-ink-950">Grassroots deadline:</span>
    <.form
      for={@deadline_form}
      id="grassroots-deadline-form"
      phx-submit="save_deadline"
      class="flex flex-wrap items-center gap-2.5"
    >
      <.input
        field={@deadline_form[:completion_deadline]}
        type="date"
        class="rounded-lg border border-red-500 px-2.5 py-1.5 font-mono text-sm text-ink-950"
      />
      <button
        type="submit"
        class="rounded-full bg-ink-950 px-4 py-2 text-[13px] font-semibold text-white hover:bg-ink-900"
      >
        Save
      </button>
    </.form>
    <span
      :if={is_nil(@stage.completion_deadline)}
      class="rounded-full bg-amber-100 px-2.5 py-1 text-[13px] font-semibold text-amber-900"
    >
      Not set — set a deadline
    </span>
    <span class="basis-full text-[12.5px] text-ink-500">
      Applies to every Grassroots venue and category. Fixtures still unplayed when it passes become a double walkover (no result). Publishing a draw never sets this automatically; clear the date to remove it.
    </span>
  </div>

  <div :if={@panel == :participants}>
    <.form for={@filter_form} phx-change="filter_participants" class="mb-4 flex flex-wrap gap-2.5">
      <.input
        field={@filter_form[:region_id]}
        type="select"
        options={Enum.map(@regions, &{&1.name, &1.id})}
        class="cursor-pointer rounded-full border border-ink-300 bg-white px-[15px] py-2.5 font-sans text-sm text-ink-950"
      />
      <.input
        field={@filter_form[:category]}
        type="select"
        options={@categories}
        class="cursor-pointer rounded-full border border-ink-300 bg-white px-[15px] py-2.5 font-sans text-sm text-ink-950"
      />
    </.form>

    <div
      :if={@participations != []}
      class="overflow-hidden rounded-2xl border border-ink-200 bg-white shadow-[0_1px_2px_rgba(13,12,34,0.05)]"
    >
      <div
        :for={p <- @participations}
        class="flex flex-wrap items-center gap-3.5 border-b border-ink-100 px-4.5 py-3.5 last:border-0"
      >
        <div class="min-w-[180px] flex-1">
          <div class="text-[14.5px] font-semibold text-ink-950">{participant_name(p)}</div>
          <div class="text-[12.5px] text-ink-400">{participant_sub(p)}</div>
        </div>
        <PlayerComponents.stage_badge stage={@stage.name} />
        <button
          :if={@next_stage}
          type="button"
          phx-click="advance"
          phx-value-id={p.id}
          class="rounded-full border border-ink-300 px-3.5 py-[7px] text-[13px] font-semibold text-ink-700 hover:bg-ink-50"
        >
          Advance → {@next_stage.name}
        </button>
      </div>
    </div>
    <div
      :if={@participations == []}
      class="rounded-2xl border border-ink-200 bg-white px-[22px] py-9 text-center text-sm text-ink-400 shadow-[0_1px_2px_rgba(13,12,34,0.05)]"
    >
      No participants for this stage/region/category yet.
    </div>
  </div>

  <div :if={@panel == :capacity}>
    <p :if={@configs != []} class="mb-3.5 text-[13.5px] text-ink-500">
      Circuit and Finals run single knockout brackets per category, capped by entrant count.
    </p>
    <div
      :if={@configs != []}
      class="mb-5 overflow-hidden rounded-2xl border border-ink-200 bg-white shadow-[0_1px_2px_rgba(13,12,34,0.05)]"
    >
      <table class="w-full border-collapse">
        <thead>
          <tr class="border-b border-ink-200 bg-ink-25">
            <th class="px-4 py-2.5 text-left font-mono text-[11px] font-semibold uppercase tracking-[0.06em] text-ink-500">
              Category
            </th>
            <th class="px-4 py-2.5 text-left font-mono text-[11px] font-semibold uppercase tracking-[0.06em] text-ink-500">
              Current / Limit
            </th>
            <th class="px-4 py-2.5"></th>
          </tr>
        </thead>
        <tbody>
          <tr :for={config <- @configs} class="border-b border-ink-100 last:border-0">
            <td class="px-4 py-2.5 text-[14px] font-semibold text-ink-950">
              {config.category}
            </td>
            <td class="px-4 py-2.5 font-mono text-sm text-ink-700">
              <.form
                :if={@editing_config && @editing_config.id == config.id}
                for={@config_form}
                phx-submit="save_config"
                class="flex items-center gap-2"
              >
                {config.current_count} /
                <input
                  type="number"
                  name={@config_form[:capacity_limit].name}
                  id={@config_form[:capacity_limit].id}
                  value={@config_form[:capacity_limit].value}
                  class="w-[70px] rounded-lg border border-red-500 px-2 py-1 font-mono text-sm text-ink-950 focus:outline-none"
                />
                <button
                  type="submit"
                  class="rounded-full bg-ink-950 px-3.5 py-1.5 text-[13px] font-semibold text-white hover:bg-ink-900"
                >
                  Save
                </button>
              </.form>
              <span :if={is_nil(@editing_config) or @editing_config.id != config.id}>
                {config.current_count} / {config.capacity_limit}
              </span>
            </td>
            <td class="px-4 py-2.5 text-right">
              <button
                :if={is_nil(@editing_config) or @editing_config.id != config.id}
                type="button"
                phx-click="edit_config"
                phx-value-id={config.id}
                class="rounded-full border border-ink-300 px-3.5 py-[7px] text-[13px] font-semibold text-ink-700 hover:bg-ink-50"
              >
                Edit limit
              </button>
            </td>
          </tr>
        </tbody>
      </table>
    </div>
    <div
      :if={@configs == [] and @group_configs == []}
      class="rounded-2xl border border-ink-200 bg-white px-[22px] py-9 text-center text-sm text-ink-400 shadow-[0_1px_2px_rgba(13,12,34,0.05)]"
    >
      {@stage.name} is open — no capacity limit configured.
    </div>

    <div :if={@group_configs != []}>
      <p class="mb-3.5 text-[13.5px] text-ink-500">
        Grassroots and Regional are open, round-robin stages — this configures group size and how many advance, not a capacity limit.
      </p>
      <p :if={@stage.name == "Grassroots"} class="-mt-2 mb-3.5 text-[13.5px] text-ink-500">
        Target/min size and minimum entrants drive the automatic draw formula; overriding the group count on a specific draw doesn't change these defaults.
      </p>
      <div class="mb-3.5 overflow-x-auto rounded-2xl border border-ink-200 bg-white shadow-[0_1px_2px_rgba(13,12,34,0.05)]">
        <table class="w-full min-w-[560px] border-collapse">
          <thead>
            <tr class="border-b border-ink-200 bg-ink-25">
              <th class="px-4 py-2.5 text-left font-mono text-[11px] font-semibold uppercase tracking-[0.06em] text-ink-500">
                Category
              </th>
              <th class="px-4 py-2.5 text-left font-mono text-[11px] font-semibold uppercase tracking-[0.06em] text-ink-500">
                Group size
              </th>
              <th class="px-4 py-2.5 text-left font-mono text-[11px] font-semibold uppercase tracking-[0.06em] text-ink-500">
                Top N advance
              </th>
              <%= if @stage.name == "Grassroots" do %>
                <th class="px-4 py-2.5 text-left font-mono text-[11px] font-semibold uppercase tracking-[0.06em] text-ink-500">
                  Target size
                </th>
                <th class="px-4 py-2.5 text-left font-mono text-[11px] font-semibold uppercase tracking-[0.06em] text-ink-500">
                  Min size
                </th>
                <th class="px-4 py-2.5 text-left font-mono text-[11px] font-semibold uppercase tracking-[0.06em] text-ink-500">
                  Min entrants
                </th>
              <% end %>
            </tr>
          </thead>
          <tbody>
            <tr :for={config <- @group_configs} class="border-b border-ink-100 last:border-0">
              <td class="px-4 py-2.5 text-[14px] font-semibold text-ink-950">
                {group_category_label(config.category)}
              </td>
              <td class="px-4 py-2.5">
                <.editable_field
                  config={config}
                  field="group_size"
                  editing_field={@editing_field}
                />
              </td>
              <td class="px-4 py-2.5">
                <.editable_field
                  config={config}
                  field="advancer_count"
                  editing_field={@editing_field}
                />
              </td>
              <%= if @stage.name == "Grassroots" do %>
                <%= if config.category == "team" do %>
                  <td class="px-4 py-2.5 font-mono text-sm text-ink-400">—</td>
                  <td class="px-4 py-2.5 font-mono text-sm text-ink-400">—</td>
                  <td class="px-4 py-2.5 font-mono text-sm text-ink-400">—</td>
                <% else %>
                  <td class="px-4 py-2.5">
                    <.editable_field
                      config={config}
                      field="target_group_size"
                      editing_field={@editing_field}
                    />
                  </td>
                  <td class="px-4 py-2.5">
                    <.editable_field
                      config={config}
                      field="minimum_group_size"
                      editing_field={@editing_field}
                    />
                  </td>
                  <td class="px-4 py-2.5">
                    <.editable_field
                      config={config}
                      field="minimum_entrants"
                      editing_field={@editing_field}
                    />
                  </td>
                <% end %>
              <% end %>
            </tr>
          </tbody>
        </table>
      </div>

      <div
        :if={@stage.name == "Grassroots"}
        class="overflow-hidden rounded-2xl border border-ink-200 bg-white shadow-[0_1px_2px_rgba(13,12,34,0.05)]"
      >
        <table class="w-full border-collapse">
          <thead>
            <tr class="border-b border-ink-200 bg-ink-25">
              <th class="px-4 py-2.5 text-left font-mono text-[11px] font-semibold uppercase tracking-[0.06em] text-ink-500">
                Category
              </th>
              <th class="px-4 py-2.5 text-left font-mono text-[11px] font-semibold uppercase tracking-[0.06em] text-ink-500">
                Best-of-rest qualifiers
              </th>
            </tr>
          </thead>
          <tbody>
            <tr
              :for={config <- Enum.reject(@group_configs, &(&1.category == "team"))}
              class="border-b border-ink-100 last:border-0"
            >
              <td class="px-4 py-2.5 text-[14px] font-semibold text-ink-950">
                {group_category_label(config.category)}
              </td>
              <td class="px-4 py-2.5">
                <.editable_field
                  config={config}
                  field="extra_qualifier_count"
                  editing_field={@editing_field}
                />
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</AdminComponents.app_shell>
