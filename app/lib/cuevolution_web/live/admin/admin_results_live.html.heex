<AdminComponents.app_shell current_admin={@current_admin} active={:results} flash={@flash}>
  <AdminComponents.eyebrow class="mb-1.5">Results &amp; Points</AdminComponents.eyebrow>
  <h1 class="mb-5 text-[clamp(24px,4vw,30px)] font-bold tracking-tight text-ink-950">
    Match results
  </h1>

  <div
    :if={@missing_scope?}
    class="mb-6 rounded-2xl border border-amber-200 bg-amber-50 px-5 py-6 text-sm text-amber-900"
  >
    <%= if @current_admin.role == "regional_coordinator" do %>
      Your admin account is not assigned to a region yet. Ask a Tournament Director or Super Admin to assign one.
    <% else %>
      Your admin account is not assigned to a venue yet. Ask a Tournament Director or Super Admin to assign one.
    <% end %>
  </div>

  <section
    :if={@can_approve_results?}
    id="result-approval-queue"
    class="mb-6 rounded-2xl border border-ink-200 bg-white p-4 shadow-[0_1px_2px_rgba(13,12,34,0.05)] sm:p-5"
  >
    <div class="mb-4 flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <AdminComponents.eyebrow class="mb-1">Tournament director</AdminComponents.eyebrow>
        <h2 class="text-lg font-bold text-ink-950">Provisional results awaiting approval</h2>
        <p class="mt-1 text-sm text-ink-500">
          Search or filter, select one or more results, then approve them as final.
        </p>
      </div>
      <div class="flex flex-wrap items-center gap-2.5">
        <form id="approval-search-form" phx-change="search_approval" class="relative">
          <.icon
            name="hero-magnifying-glass"
            class="pointer-events-none absolute left-3 top-1/2 size-4 -translate-y-1/2 text-ink-400"
          />
          <input
            type="text"
            name="search[term]"
            value={@approval_search_form[:term].value}
            phx-debounce="300"
            placeholder="Search by player username or name"
            class="w-56 rounded-full border border-ink-300 bg-white py-2 pl-9 pr-8 text-sm text-ink-950 placeholder:text-ink-400 focus:border-red-500 focus:outline-none focus:ring-[3px] focus:ring-red-500/15"
          />
          <button
            :if={@approval_search}
            type="button"
            phx-click="clear_approval_search"
            class="absolute right-2.5 top-1/2 -translate-y-1/2 text-ink-400 hover:text-ink-950"
            aria-label="Clear search"
          >
            <.icon name="hero-x-mark" class="size-4" />
          </button>
        </form>

        <div
          class="relative inline-block text-left"
          id="approval-filters"
          phx-click-away={JS.hide(to: "#approval-filters-panel")}
        >
          <button
            type="button"
            phx-click={JS.toggle(to: "#approval-filters-panel")}
            class={[
              "flex items-center gap-1.5 rounded-full border px-4 py-2 text-sm font-semibold",
              (@approval_region_id || @approval_venue_id) && "border-ink-950 text-ink-950",
              !(@approval_region_id || @approval_venue_id) &&
                "border-ink-300 text-ink-700 hover:border-ink-950"
            ]}
          >
            <.icon name="hero-funnel" class="size-4" /> Filters
            <span
              :if={@approval_region_id || @approval_venue_id}
              class="ml-0.5 size-[7px] rounded-full bg-red-500"
            />
          </button>
          <div
            id="approval-filters-panel"
            class="absolute right-0 top-10 z-10 hidden w-72 rounded-xl border border-ink-200 bg-white p-4 shadow-lg"
          >
            <form id="result-approval-filters" phx-change="filter_approval" class="space-y-3">
              <div>
                <label
                  for="approval-region-filter"
                  class="mb-1.5 block text-xs font-semibold text-ink-500"
                >
                  Region
                </label>
                <select
                  id="approval-region-filter"
                  name="region_id"
                  class="w-full rounded-full border border-ink-300 bg-white px-3 py-2 text-sm text-ink-950 focus:border-red-500 focus:outline-none focus:ring-[3px] focus:ring-red-500/15"
                >
                  <option value="">All regions</option>
                  <option
                    :for={region <- @approval_regions}
                    value={region.id}
                    selected={@approval_region_id == region.id}
                  >
                    {region.name}
                  </option>
                </select>
              </div>
              <div>
                <label
                  for="approval-venue-filter"
                  class="mb-1.5 block text-xs font-semibold text-ink-500"
                >
                  Venue
                </label>
                <select
                  id="approval-venue-filter"
                  name="venue_id"
                  class="w-full rounded-full border border-ink-300 bg-white px-3 py-2 text-sm text-ink-950 focus:border-red-500 focus:outline-none focus:ring-[3px] focus:ring-red-500/15"
                >
                  <option value="">All venues</option>
                  <option
                    :for={venue <- @approval_venues}
                    value={venue.id}
                    selected={@approval_venue_id == venue.id}
                  >
                    {venue.name}
                  </option>
                </select>
              </div>
            </form>
            <button
              :if={@approval_region_id || @approval_venue_id}
              type="button"
              phx-click="clear_approval_filters"
              class="mt-3 text-xs font-semibold text-ink-500 hover:text-ink-950"
            >
              Clear filters
            </button>
          </div>
        </div>

        <button
          :if={@approval_tab == "pending"}
          id="approve-selected-results"
          type="button"
          phx-click="approve_selected_results"
          disabled={MapSet.size(@selected_result_ids) == 0}
          class="inline-flex min-h-10 items-center justify-center rounded-full bg-ink-950 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-ink-800 disabled:cursor-not-allowed disabled:opacity-40"
        >
          Approve selected ({MapSet.size(@selected_result_ids)})
        </button>
      </div>
    </div>

    <div :if={@can_approve_results?} class="mb-4 flex gap-2 border-b border-ink-200">
      <button
        type="button"
        phx-click="switch_approval_tab"
        phx-value-tab="pending"
        class={[
          "whitespace-nowrap border-b-2 px-1 py-[11px] text-[14.5px] font-semibold",
          @approval_tab == "pending" && "border-red-500 text-ink-950",
          @approval_tab != "pending" && "border-transparent text-ink-500 hover:text-ink-950"
        ]}
      >
        Pending approval
      </button>
      <button
        type="button"
        phx-click="switch_approval_tab"
        phx-value-tab="approved"
        class={[
          "whitespace-nowrap border-b-2 px-1 py-[11px] text-[14.5px] font-semibold",
          @approval_tab == "approved" && "border-red-500 text-ink-950",
          @approval_tab != "approved" && "border-transparent text-ink-500 hover:text-ink-950"
        ]}
      >
        Approved
      </button>
    </div>

    <div class={@approval_tab != "pending" && "hidden"}>
      <p class="mb-3 text-sm text-ink-500">
        Click a result to review and correct it before approving, or check several and approve them together.
      </p>
      <div
        id="pending-results"
        phx-update="stream"
        class="overflow-hidden rounded-xl border border-ink-200"
      >
        <div
          id="pending-results-empty"
          class="hidden only:block px-4 py-8 text-center text-sm text-ink-400"
        >
          No provisional results match these filters.
        </div>
        <div
          :for={{dom_id, fixture} <- @streams.pending_results}
          id={dom_id}
          class={[
            "flex items-start gap-3 border-b border-ink-100 px-3 py-3 last:border-0 sm:items-center sm:px-4",
            @selected_played && @selected_played.id == fixture.id && "bg-red-50"
          ]}
        >
          <input
            id={"select-result-#{fixture.id}"}
            type="checkbox"
            phx-click="toggle_result_selection"
            phx-value-id={fixture.id}
            checked={MapSet.member?(@selected_result_ids, fixture.id)}
            class="mt-1 size-4 rounded border-ink-300 text-ink-950 focus:ring-red-500 sm:mt-0"
          />
          <button
            type="button"
            phx-click="select_played"
            phx-value-id={fixture.id}
            class="min-w-0 flex-1 cursor-pointer text-left"
          >
            <div class="font-semibold text-[13.5px] text-ink-950">{fixture_label(fixture)}</div>
            <div class="mt-0.5 text-[12.5px] text-ink-500">
              {fixture_venue_label(fixture)} · Provisional
            </div>
          </button>
        </div>
      </div>

      <nav
        :if={@approval_total_pages > 1}
        id="approval-pagination"
        aria-label="Approval queue pages"
        class="mt-4 flex flex-col items-center justify-between gap-3 rounded-xl border border-ink-200 p-3 sm:flex-row"
      >
        <button
          id="approval-previous-page"
          type="button"
          phx-click="change_approval_page"
          phx-value-page={@approval_page - 1}
          disabled={@approval_page == 1}
          class="min-h-10 w-full rounded-full border border-ink-300 px-4 py-2 text-sm font-semibold text-ink-700 transition hover:border-ink-950 hover:text-ink-950 disabled:cursor-not-allowed disabled:opacity-40 sm:w-auto"
        >
          Previous
        </button>
        <span class="text-sm text-ink-500">
          Page {@approval_page} of {@approval_total_pages}
        </span>
        <button
          id="approval-next-page"
          type="button"
          phx-click="change_approval_page"
          phx-value-page={@approval_page + 1}
          disabled={@approval_page == @approval_total_pages}
          class="min-h-10 w-full rounded-full bg-ink-950 px-4 py-2 text-sm font-semibold text-white transition hover:bg-ink-900 disabled:cursor-not-allowed disabled:opacity-40 sm:w-auto"
        >
          Next
        </button>
      </nav>

      <.result_detail_panel
        :if={@selected_played && @approval_tab == "pending"}
        current_admin={@current_admin}
        selected_played={@selected_played}
        correction_form={@correction_form}
        points_forms={@points_forms}
      />
    </div>

    <div :if={@can_approve_results?} class={@approval_tab != "approved" && "hidden"}>
      <p class="mb-3 text-sm text-ink-500">
        Already-approved results. Select one to edit its winner or Cuevo Points — this stays available to Tournament Directors and Super Admins after a result is final.
      </p>
      <div
        id="approved-results"
        phx-update="stream"
        class="overflow-hidden rounded-2xl border border-ink-200 bg-white shadow-[0_1px_2px_rgba(13,12,34,0.05)]"
      >
        <div
          :for={{dom_id, fixture} <- @streams.approved_results}
          id={dom_id}
          phx-click="select_played"
          phx-value-id={fixture.id}
          class={[
            "cursor-pointer border-b border-ink-100 px-4.5 py-3.5 text-[14px] last:border-0 hover:bg-ink-50",
            @selected_played && @selected_played.id == fixture.id && "bg-red-50"
          ]}
        >
          <div class="font-semibold text-ink-950">{fixture_label(fixture)}</div>
          <div class="text-[12.5px] text-ink-500">
            {fixture_venue_label(fixture)} · {played_fixture_summary(fixture)}
          </div>
        </div>
      </div>
      <div :if={@approved_results_empty?} class="px-2 py-9 text-center text-sm text-ink-400">
        No approved results match these filters.
      </div>

      <nav
        :if={@approved_total_pages > 1}
        id="approved-pagination"
        aria-label="Approved results pages"
        class="mt-4 flex flex-col items-center justify-between gap-3 rounded-xl border border-ink-200 p-3 sm:flex-row"
      >
        <button
          id="approved-previous-page"
          type="button"
          phx-click="change_approved_page"
          phx-value-page={@approved_page - 1}
          disabled={@approved_page == 1}
          class="min-h-10 w-full rounded-full border border-ink-300 px-4 py-2 text-sm font-semibold text-ink-700 transition hover:border-ink-950 hover:text-ink-950 disabled:cursor-not-allowed disabled:opacity-40 sm:w-auto"
        >
          Previous
        </button>
        <span class="text-sm text-ink-500">
          Page {@approved_page} of {@approved_total_pages}
        </span>
        <button
          id="approved-next-page"
          type="button"
          phx-click="change_approved_page"
          phx-value-page={@approved_page + 1}
          disabled={@approved_page == @approved_total_pages}
          class="min-h-10 w-full rounded-full bg-ink-950 px-4 py-2 text-sm font-semibold text-white transition hover:bg-ink-900 disabled:cursor-not-allowed disabled:opacity-40 sm:w-auto"
        >
          Next
        </button>
      </nav>

      <.result_detail_panel
        :if={@selected_played && @approval_tab == "approved"}
        current_admin={@current_admin}
        selected_played={@selected_played}
        correction_form={@correction_form}
        points_forms={@points_forms}
      />
    </div>
  </section>

  <div
    :if={@show_record_tabs?}
    class="mb-4 flex gap-2 border-b border-ink-200"
  >
    <button
      type="button"
      phx-click="switch_tab"
      phx-value-tab="unplayed"
      class={[
        "whitespace-nowrap border-b-2 px-1 py-[11px] text-[14.5px] font-semibold",
        @tab == "unplayed" && "border-red-500 text-ink-950",
        @tab != "unplayed" && "border-transparent text-ink-500 hover:text-ink-950"
      ]}
    >
      Unplayed
    </button>
    <button
      type="button"
      phx-click="switch_tab"
      phx-value-tab="played"
      class={[
        "whitespace-nowrap border-b-2 px-1 py-[11px] text-[14.5px] font-semibold",
        @tab == "played" && "border-red-500 text-ink-950",
        @tab != "played" && "border-transparent text-ink-500 hover:text-ink-950"
      ]}
    >
      Played / Correct
    </button>
  </div>

  <div
    :if={@show_record_tabs?}
    class={["grid grid-cols-1 gap-4 lg:grid-cols-[1fr_360px]", @tab != "unplayed" && "hidden"]}
  >
    <div
      id="unplayed-fixtures"
      phx-update="stream"
      class="overflow-hidden rounded-2xl border border-ink-200 bg-white shadow-[0_1px_2px_rgba(13,12,34,0.05)]"
    >
      <div
        :for={{dom_id, fixture} <- @streams.unplayed}
        id={dom_id}
        phx-click="select_fixture"
        phx-value-id={fixture.id}
        class={[
          "cursor-pointer border-b border-ink-100 px-4.5 py-3.5 text-[14px] last:border-0 hover:bg-ink-50",
          @selected_unplayed && @selected_unplayed.id == fixture.id && "bg-red-50"
        ]}
      >
        <div class="font-semibold text-ink-950">{fixture_label(fixture)}</div>
        <div class="text-[12.5px] text-ink-500">{fixture_venue_label(fixture)}</div>
      </div>
    </div>
    <div :if={@unplayed_empty?} class="px-2 py-9 text-center text-sm text-ink-400">
      No unplayed fixtures.
    </div>

    <div
      :if={@selected_unplayed}
      class="rounded-2xl border border-ink-200 bg-white p-4.5 shadow-[0_1px_2px_rgba(13,12,34,0.05)]"
    >
      <h2 class="mb-3 text-[14.5px] font-bold text-ink-950">Record result</h2>
      <.form for={@result_form} phx-submit="record_result" class="flex flex-col gap-2.5">
        <label class="flex items-center gap-2 text-[13.5px] text-ink-700">
          <input
            type="radio"
            name="result[winner_participation_id]"
            value={@selected_unplayed.participant_a_id}
          />
          {Competitions.participant_name(@selected_unplayed.participant_a)} wins
        </label>
        <label class="flex items-center gap-2 text-[13.5px] text-ink-700">
          <input
            type="radio"
            name="result[winner_participation_id]"
            value={@selected_unplayed.participant_b_id}
          />
          {Competitions.participant_name(@selected_unplayed.participant_b)} wins
        </label>
        <div class="flex items-center gap-2">
          <input
            type="number"
            name="result[participant_a_frames]"
            placeholder="A frames (optional)"
            class="w-1/2 rounded-lg border border-ink-300 bg-white px-2.5 py-2 text-[13px] text-ink-950 placeholder:text-ink-400"
          />
          <input
            type="number"
            name="result[participant_b_frames]"
            placeholder="B frames (optional)"
            class="w-1/2 rounded-lg border border-ink-300 bg-white px-2.5 py-2 text-[13px] text-ink-950 placeholder:text-ink-400"
          />
        </div>
        <button
          type="submit"
          class="mt-1.5 rounded-full bg-ink-950 px-4 py-2 text-[13px] font-semibold text-white hover:bg-ink-900"
        >
          Save result
        </button>
      </.form>
    </div>
  </div>

  <div :if={@show_record_tabs?} class={@tab != "played" && "hidden"}>
    <div
      id="played-fixtures"
      phx-update="stream"
      class="overflow-hidden rounded-2xl border border-ink-200 bg-white shadow-[0_1px_2px_rgba(13,12,34,0.05)]"
    >
      <div
        :for={{dom_id, fixture} <- @streams.played}
        id={dom_id}
        phx-click="select_played"
        phx-value-id={fixture.id}
        class={[
          "cursor-pointer border-b border-ink-100 px-4.5 py-3.5 text-[14px] last:border-0 hover:bg-ink-50",
          @selected_played && @selected_played.id == fixture.id && "bg-red-50"
        ]}
      >
        <div class="font-semibold text-ink-950">{fixture_label(fixture)}</div>
        <div class="text-[12.5px] text-ink-500">
          {played_fixture_summary(fixture)}
        </div>
      </div>
    </div>
    <div :if={@played_empty?} class="px-2 py-9 text-center text-sm text-ink-400">
      No played fixtures yet.
    </div>

    <.result_detail_panel
      :if={@selected_played}
      current_admin={@current_admin}
      selected_played={@selected_played}
      correction_form={@correction_form}
      points_forms={@points_forms}
    />
  </div>
</AdminComponents.app_shell>
