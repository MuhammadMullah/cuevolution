<AdminComponents.guest_shell flash={@flash}>
  <div class="mb-2.5 font-mono text-[11px] font-medium uppercase tracking-[0.14em] text-red-300">
    League Admin
  </div>
  <h1 class="mb-1.5 text-2xl font-bold tracking-tight text-ink-25">Admin sign in</h1>
  <p class="mb-6 text-sm leading-relaxed text-ink-400">
    Restricted access. Separate from player accounts.
  </p>

  <.form for={@form} action={~p"/admin/login"} method="post">
    <div class="mb-4">
      <label for={@form[:email].id} class="mb-1.5 block text-[13px] font-semibold text-ink-300">
        Email or username
      </label>
      <input
        type="email"
        name={@form[:email].name}
        id={@form[:email].id}
        placeholder="admin@cuevolution.ke"
        required
        class="w-full rounded-[10px] border border-[#33324a] bg-ink-950 px-3.5 py-[11px] text-[15px] text-ink-25 placeholder:text-ink-500 focus:border-red-500 focus:outline-none focus:ring-[3px] focus:ring-red-500/20"
      />
    </div>
    <div class="mb-2">
      <label for={@form[:password].id} class="mb-1.5 block text-[13px] font-semibold text-ink-300">
        Password
      </label>
      <div class="relative" phx-hook=".PasswordToggle" id={"#{@form[:password].id}-toggle"}>
        <input
          type="password"
          name={@form[:password].name}
          id={@form[:password].id}
          placeholder="••••••••"
          required
          class="w-full rounded-[10px] border border-[#33324a] bg-ink-950 px-3.5 py-[11px] pr-11 text-[15px] text-ink-25 placeholder:text-ink-500 focus:border-red-500 focus:outline-none focus:ring-[3px] focus:ring-red-500/20"
        />
        <button
          type="button"
          class="absolute inset-y-0 right-0 flex w-10 items-center justify-center text-ink-400 hover:text-ink-200 cursor-pointer"
          aria-label="Show password"
        >
          <.icon name="hero-eye" class="password-toggle-show size-5" />
          <.icon name="hero-eye-slash" class="password-toggle-hide hidden size-5" />
        </button>
        <script :type={Phoenix.LiveView.ColocatedHook} name=".PasswordToggle">
          export default {
            mounted() {
              const input = this.el.querySelector("input")
              const button = this.el.querySelector("button")
              const showIcon = this.el.querySelector(".password-toggle-show")
              const hideIcon = this.el.querySelector(".password-toggle-hide")
              this.onClick = () => {
                const revealing = input.type === "password"
                input.type = revealing ? "text" : "password"
                showIcon.classList.toggle("hidden", revealing)
                hideIcon.classList.toggle("hidden", !revealing)
                button.setAttribute("aria-label", revealing ? "Hide password" : "Show password")
              }
              button.addEventListener("click", this.onClick)
            },
            destroyed() {
              this.el.querySelector("button").removeEventListener("click", this.onClick)
            }
          }
        </script>
      </div>
    </div>

    <div
      :if={msg = Phoenix.Flash.get(@flash, :error)}
      class="my-3.5 rounded-[10px] border border-red-500/30 bg-red-500/15 px-3 py-2.5 text-[13px] font-medium text-red-300"
    >
      {msg}
    </div>

    <button
      type="submit"
      class="mt-2 w-full cursor-pointer rounded-full bg-red-500 px-6 py-[13px] text-[15px] font-semibold text-white hover:bg-red-600"
    >
      Sign in
    </button>
  </.form>

  <p class="mt-4.5 text-center text-[12.5px] text-ink-500">
    Forgot your password? Contact the platform operator directly.
  </p>
</AdminComponents.guest_shell>
