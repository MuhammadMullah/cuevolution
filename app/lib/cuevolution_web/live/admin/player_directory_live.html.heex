<AdminComponents.app_shell current_admin={@current_admin} active={:directory} flash={@flash}>
  <AdminComponents.eyebrow class="mb-1.5">Directory</AdminComponents.eyebrow>
  <h1 class="mb-[18px] text-[clamp(24px,4vw,30px)] font-bold tracking-tight text-ink-950">
    Players &amp; teams
  </h1>
  <div class="mb-4 flex flex-wrap items-center gap-2.5">
    <.link
      :if={Cuevolution.Accounts.Admin.can?(@current_admin, :manage_teams)}
      navigate={~p"/admin/teams/new"}
      class="inline-flex rounded-full bg-ink-950 px-4 py-2 text-sm font-semibold text-white hover:bg-ink-800"
    >
      Create team
    </.link>
    <button
      type="submit"
      form="player-filter-form"
      formaction={~p"/admin/directory/export.csv"}
      formmethod="get"
      class="inline-flex rounded-full border border-ink-300 px-4 py-2 text-sm font-semibold text-ink-700 hover:border-ink-950 hover:text-ink-950"
    >
      Export CSV
    </button>
    <button
      type="submit"
      form="player-filter-form"
      formaction={~p"/admin/directory/export.xlsx"}
      formmethod="get"
      class="inline-flex rounded-full border border-ink-300 px-4 py-2 text-sm font-semibold text-ink-700 hover:border-ink-950 hover:text-ink-950"
    >
      Export Excel
    </button>
  </div>

  <.form
    for={@filter_form}
    phx-change="filter"
    id="player-filter-form"
    class="mb-4 flex flex-wrap gap-2.5"
  >
    <div class="min-w-[220px] flex-1">
      <.input
        field={@filter_form[:search]}
        placeholder="Search name or @username…"
        class="w-full rounded-full border border-ink-300 bg-white px-4 py-2.5 font-sans text-sm text-ink-950 placeholder:text-ink-400 focus:border-red-500 focus:outline-none focus:ring-[3px] focus:ring-red-500/15"
      />
    </div>
    <.input
      field={@filter_form[:kind]}
      type="select"
      options={@kinds}
      class="cursor-pointer rounded-full border border-ink-300 bg-white px-[15px] py-2.5 font-sans text-sm text-ink-950"
    />
    <.input
      field={@filter_form[:region_id]}
      type="select"
      prompt="All regions"
      options={Enum.map(@regions, &{&1.name, &1.id})}
      class="cursor-pointer rounded-full border border-ink-300 bg-white px-[15px] py-2.5 font-sans text-sm text-ink-950"
    />
    <.input
      field={@filter_form[:venue_id]}
      type="select"
      prompt="All venues"
      options={Enum.map(@venues, &{venue_option_label(&1, @filters[:region_id]), &1.id})}
      class="cursor-pointer rounded-full border border-ink-300 bg-white px-[15px] py-2.5 font-sans text-sm text-ink-950"
    />
    <.input
      field={@filter_form[:stage_id]}
      type="select"
      prompt="All stages"
      options={Enum.map(@stages, &{&1.name, &1.id})}
      class="cursor-pointer rounded-full border border-ink-300 bg-white px-[15px] py-2.5 font-sans text-sm text-ink-950"
    />
  </.form>

  <div class="mb-2.5 font-mono text-[13px] text-ink-500">
    Showing {length(@rows)} of {@total_count} result{if @total_count == 1, do: "", else: "s"}
  </div>

  <div
    :if={@rows != []}
    class="max-h-[60vh] overflow-auto rounded-2xl border border-ink-200 bg-white shadow-[0_1px_2px_rgba(13,12,34,0.05)]"
  >
    <.link
      :for={row <- @rows}
      navigate={row.path}
      class="flex items-center gap-3.5 border-b border-ink-100 px-4 py-3 last:border-0 hover:bg-ink-50"
    >
      <PlayerComponents.avatar name={row.avatar_name} src={row.avatar_src} size="size-9" />
      <div class="min-w-0 flex-1">
        <div class="text-[14.5px] font-semibold text-ink-950">
          {row.name}
          <span :if={row.anonymized} class="ml-1.5 text-[11.5px] font-semibold text-ink-400">
            ANONYMIZED
          </span>
        </div>
        <div class="text-[12.5px] text-ink-400">{row.sub}</div>
      </div>
      <PlayerComponents.stage_badge :if={row.stage} stage={row.stage.name} />
    </.link>
  </div>
  <div :if={@total_pages > 1} class="mt-4 flex items-center justify-between gap-3">
    <button
      id="directory-previous-page"
      type="button"
      phx-click="page"
      phx-value-page={@page - 1}
      disabled={@page == 1}
      class="rounded-full border border-ink-300 px-4 py-2 text-sm font-semibold text-ink-700 transition hover:border-ink-950 hover:text-ink-950 disabled:cursor-not-allowed disabled:opacity-40"
    >
      Previous
    </button>
    <span class="font-mono text-[13px] text-ink-500">Page {@page} of {@total_pages}</span>
    <button
      id="directory-next-page"
      type="button"
      phx-click="page"
      phx-value-page={@page + 1}
      disabled={@page == @total_pages}
      class="rounded-full border border-ink-300 px-4 py-2 text-sm font-semibold text-ink-700 transition hover:border-ink-950 hover:text-ink-950 disabled:cursor-not-allowed disabled:opacity-40"
    >
      Next
    </button>
  </div>
  <div
    :if={@rows == []}
    class="rounded-2xl border border-ink-200 bg-white px-[22px] py-10 text-center shadow-[0_1px_2px_rgba(13,12,34,0.05)]"
  >
    <h3 class="mb-1.5 text-[17px] font-bold text-ink-950">No matches for these filters</h3>
    <p class="text-[13.5px] text-ink-500">Try a broader search or clear a filter.</p>
  </div>
</AdminComponents.app_shell>
