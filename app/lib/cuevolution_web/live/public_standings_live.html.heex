<div class="min-h-screen bg-ink-50">
  <header class="border-b border-ink-200 bg-white">
    <div class="mx-auto flex max-w-5xl flex-wrap items-center gap-3 px-4 py-4">
      <div>
        <p class="font-mono text-[10.5px] font-medium uppercase tracking-[0.12em] text-red-500">
          SportPesa National Pool Circuit
        </p>
        <h1 class="text-xl font-bold tracking-tight text-ink-950 sm:text-2xl">
          Live scores &amp; standings
        </h1>
      </div>

      <.link
        navigate={~p"/matches"}
        class="ml-auto text-[13px] font-semibold text-ink-500 hover:text-ink-950"
      >
        All fixtures
      </.link>
      <span class="inline-flex items-center gap-1.5 rounded-full bg-red-50 px-3 py-1 text-[12px] font-semibold text-red-700">
        <span class="h-2 w-2 animate-pulse rounded-full bg-red-500"></span>
        {@live_count} in play
      </span>
    </div>
  </header>

  <main class="mx-auto max-w-5xl px-4 py-5">
    <div class="mb-4 flex flex-wrap items-center gap-3">
      <div class="flex gap-1 rounded-xl bg-ink-100 p-1">
        <button
          :for={{label, view} <- [{"Live", :live}, {"Table", :table}]}
          type="button"
          phx-click="switch"
          phx-value-view={view}
          class={[
            "min-h-11 rounded-lg px-4 py-1.5 text-[13.5px] font-semibold sm:min-h-0",
            @view == view && "bg-white text-ink-950 shadow-sm",
            @view != view && "text-ink-500 hover:text-ink-950"
          ]}
        >
          {label}
        </button>
      </div>

      <div class="flex flex-wrap gap-x-5 gap-y-1 border-b border-ink-200 sm:flex-nowrap sm:overflow-x-auto">
        <button
          :for={{slug, label} <- @tabs}
          type="button"
          phx-click="switch"
          phx-value-tab={slug}
          class={[
            "whitespace-nowrap border-b-2 px-0.5 pb-2 text-[14px] font-semibold",
            @tab == slug && "border-red-500 text-ink-950",
            @tab != slug && "border-transparent text-ink-500 hover:text-ink-950"
          ]}
        >
          {label}
        </button>
      </div>
    </div>

    <%!-- Live: what is happening right now, then what is next, then what has
          just finished. --%>
    <div :if={@view == :live} class="space-y-6">
      <section>
        <h2 class="mb-2 text-[13px] font-bold tracking-tight text-ink-950">In play</h2>

        <p
          :if={@matches.live == []}
          class="rounded-2xl border border-ink-200 bg-white px-5 py-6 text-center text-[13.5px] text-ink-400"
        >
          No matches in play right now.
        </p>

        <div class="grid gap-2.5 sm:grid-cols-2">
          <article
            :for={fixture <- @matches.live}
            class="rounded-2xl border-2 border-red-500 bg-white px-4 py-3"
          >
            <div class="mb-1 flex items-center justify-between text-[11px] text-ink-500">
              <span>{fixture.round.name} · race to {fixture.round.race_to}</span>
              <span class="rounded-full bg-red-500 px-2 py-0.5 font-semibold text-white">
                Live
              </span>
            </div>

            <div
              :for={
                {side, participant} <- [
                  {"a", fixture.participant_a},
                  {"b", fixture.participant_b}
                ]
              }
              class="flex items-center gap-3 py-0.5"
            >
              <span class="flex-1 truncate text-[15px] font-medium text-ink-950">
                {side_name(participant)}
              </span>
              <span class="text-xl font-bold tabular-nums text-ink-950">
                {side_score(fixture, side) || 0}
              </span>
            </div>
          </article>
        </div>
      </section>

      <section :if={@matches.next != []}>
        <h2 class="mb-2 text-[13px] font-bold tracking-tight text-ink-950">Up next</h2>

        <div class="overflow-hidden rounded-2xl border border-ink-200 bg-white">
          <div
            :for={fixture <- @matches.next}
            class="flex items-center gap-3 border-b border-ink-100 px-4 py-2.5 text-[14px] last:border-0"
          >
            <span class="w-16 shrink-0 font-mono text-[11px] text-ink-400">
              {start_time(fixture) || "—"}
            </span>
            <span class="flex-1 truncate text-ink-950">
              {side_name(fixture.participant_a)} <span class="text-ink-400">v</span>
              {side_name(fixture.participant_b)}
            </span>
            <span class="hidden shrink-0 text-[11px] text-ink-400 sm:inline">
              {fixture.round.name}
            </span>
          </div>
        </div>
      </section>

      <section :if={@matches.recent != []}>
        <h2 class="mb-2 text-[13px] font-bold tracking-tight text-ink-950">Just finished</h2>

        <div class="overflow-hidden rounded-2xl border border-ink-200 bg-white">
          <div
            :for={fixture <- @matches.recent}
            class="flex items-center gap-3 border-b border-ink-100 px-4 py-2.5 text-[14px] last:border-0"
          >
            <span class={[
              "flex-1 truncate",
              won?(fixture, "a") && "font-bold text-ink-950",
              !won?(fixture, "a") && "text-ink-500"
            ]}>
              {side_name(fixture.participant_a)}
            </span>
            <span class="shrink-0 font-bold tabular-nums text-ink-950">
              {side_score(fixture, "a")}–{side_score(fixture, "b")}
            </span>
            <span class={[
              "flex-1 truncate text-right",
              won?(fixture, "b") && "font-bold text-ink-950",
              !won?(fixture, "b") && "text-ink-500"
            ]}>
              {side_name(fixture.participant_b)}
            </span>
          </div>
        </div>
      </section>
    </div>

    <%!-- Table: the SP Points ranking that decides who reaches the Finals. --%>
    <div :if={@view == :table}>
      <%!-- The team event is the only one with groups, so the scope switch
            belongs on its tab and nowhere else. --%>
      <div :if={@tab == "team"} class="mb-3 flex w-fit gap-1 rounded-xl bg-ink-100 p-1">
        <button
          :for={{label, scope} <- scopes()}
          type="button"
          phx-click="switch"
          phx-value-scope={scope}
          class={[
            "min-h-11 rounded-lg px-4 py-1.5 text-[13.5px] font-semibold sm:min-h-0",
            @scope == scope && "bg-white text-ink-950 shadow-sm",
            @scope != scope && "text-ink-500 hover:text-ink-950"
          ]}
        >
          {label}
        </button>
      </div>

      <p
        :if={not @has_rows?}
        class="rounded-2xl border border-ink-200 bg-white px-5 py-6 text-center text-[13.5px] text-ink-400"
      >
        {empty_message(@standings_state)}
      </p>

      <div :if={@has_rows?} class="space-y-4">
        <div
          :for={section <- @sections}
          class="overflow-hidden rounded-2xl border border-ink-200 bg-white"
        >
          <div
            :if={section.title}
            class="flex items-center justify-between gap-3 border-b border-ink-200 px-4 py-2.5"
          >
            <h2 class="text-[15px] font-bold tracking-tight text-ink-950">{section.title}</h2>
            <span
              :if={section.note}
              class="text-[11px] font-medium uppercase tracking-[0.06em] text-ink-400"
            >
              {section.note}
            </span>
          </div>

          <div class="overflow-x-auto">
            <table class="w-full border-collapse">
              <thead>
                <tr>
                  <th
                    :for={{label, title, align} <- standings_columns(@standings_state)}
                    scope="col"
                    title={title}
                    class={[
                      "px-1.5 py-3 text-[10.5px] font-semibold uppercase leading-tight tracking-wide text-ink-500 sm:px-2.5 sm:text-[11px]",
                      align,
                      column_visibility(label)
                    ]}
                  >
                    {label}
                  </th>
                </tr>
              </thead>
              <tbody>
                <tr
                  :for={row <- section.rows}
                  class={[
                    "border-t border-ink-100",
                    Map.get(row, :finish) == :champion && "bg-gold-100/40",
                    @standings_state == :team_group && Map.get(row, :advancing) &&
                      "bg-green-50"
                  ]}
                >
                  <td
                    :for={{label, _title, align} <- standings_columns(@standings_state)}
                    data-label={label}
                    class={[
                      "px-1.5 py-2.5 text-[13px] sm:px-2.5",
                      align,
                      column_visibility(label),
                      label in ["Player", "Team"] &&
                        "text-[13.5px] font-medium text-ink-950 sm:text-[14px]",
                      label == "SP Points" &&
                        "whitespace-nowrap font-bold tabular-nums text-ink-950",
                      label not in ["Player", "Team", "SP Points", "Region", "Status", "Finish"] &&
                        "whitespace-nowrap tabular-nums text-ink-600",
                      label in ["Region", "Status", "Finish"] && "text-ink-600"
                    ]}
                  >
                    {standings_cell(row, label, @standings_state)}<span
                      :if={
                        label == "Team" and @standings_state == :team_group and
                          Map.get(row, :advancing)
                      }
                      title="In the top four — qualifying for the Nationals"
                      class="ml-1.5 rounded bg-green-100 px-1.5 py-0.5 text-[10px] font-bold uppercase tracking-wide text-green-700"
                    >Q</span>
                  </td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <p :if={@has_rows?} class="mt-3 text-[12px] leading-relaxed text-ink-400">
        <span :if={@standings_state == :team_group}>
          Each group is a season-long round robin, and the top four — shaded and marked
          <span class="font-mono">Q</span>
          — go to the Nationals.
          Ranked on SP Points — 2 for entering and 3 for every match won — then head-to-head,
          then frame difference. A position shown as <span class="font-mono">4=</span>
          means those
          teams are still level after every tiebreaker, so nothing yet separates them.
        </span>
        <span :if={@standings_state == :team}>
          Ranked on SP Points, then match difference and frame difference. MP/MW/ML and FP/FW/FL
          are the match and frame record, with each win percentage alongside.
        </span>
        <span :if={@standings_state not in [:team, :team_group]}>
          Ranked on SP Points, then frame-win %. Players knocked out at the same stage share a
          position, shown as <span class="font-mono">3=</span>, and share their points. MP, MW and
          ML include walkovers and byes; the frame columns leave them out.
        </span>
        <span :if={@standings_state == :provisional}>
          Provisional while the circuit is running — each player is scored on the stage they have
          reached so far.
        </span>
        <span :if={@standings_state == :final}>This circuit is over and the table is final.</span>
      </p>
    </div>
  </main>
</div>
