<div class="min-h-screen bg-ink-50">
  <header class="border-b border-ink-200 bg-white">
    <div class="mx-auto flex max-w-2xl items-center gap-3 px-4 py-4">
      <div>
        <p class="font-mono text-[10.5px] font-medium uppercase tracking-[0.12em] text-red-500">
          SportPesa National Pool Circuit
        </p>
        <h1 class="text-xl font-bold tracking-tight text-ink-950">Match</h1>
      </div>
      <.link
        navigate={~p"/live"}
        class="ml-auto text-[13px] font-semibold text-ink-500 hover:text-ink-950"
      >
        All live scores
      </.link>
    </div>
  </header>

  <main class="mx-auto max-w-2xl px-4 py-6">
    <div
      :if={is_nil(@fixture)}
      class="rounded-2xl border border-ink-200 bg-white px-5 py-10 text-center"
    >
      <p class="font-semibold text-ink-900">No match with that reference</p>
      <p class="mt-1 text-[13.5px] text-ink-500">
        <span class="font-mono">{@match_id}</span>
        does not match any fixture. Check the link, or browse the
        <.link navigate={~p"/live"} class="font-semibold text-ink-950 underline">
          live scores
        </.link>
        instead.
      </p>
    </div>

    <div :if={@fixture} class="overflow-hidden rounded-2xl border border-ink-200 bg-white">
      <div class="flex items-center gap-3 border-b border-ink-200 px-5 py-3">
        <span class={[
          "inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 text-[11px] font-bold uppercase tracking-[0.06em]",
          state(@fixture) == :live && "bg-red-50 text-red-700",
          state(@fixture) == :final && "bg-green-50 text-green-700",
          state(@fixture) == :walkover && "bg-amber-50 text-amber-700",
          state(@fixture) == :upcoming && "bg-ink-100 text-ink-500"
        ]}>
          <span
            :if={state(@fixture) == :live}
            class="h-1.5 w-1.5 animate-pulse rounded-full bg-red-500"
          />
          {state_label(@fixture)}
        </span>
        <span class="truncate text-[12.5px] text-ink-500">
          {Competitions.match_round_label(@fixture)}
        </span>
      </div>

      <div class="divide-y divide-ink-100">
        <div
          :for={
            {participant, side} <- [
              {@fixture.participant_a, "a"},
              {@fixture.participant_b, "b"}
            ]
          }
          class={[
            "flex items-center gap-4 px-5 py-4",
            won?(@fixture, side) && "bg-green-50/50"
          ]}
        >
          <span class={[
            "flex-1 truncate text-[16px]",
            won?(@fixture, side) && "font-bold text-ink-950",
            !won?(@fixture, side) && "text-ink-700"
          ]}>
            {side_name(participant)}
          </span>
          <span class={[
            "shrink-0 font-mono text-[22px] tabular-nums",
            won?(@fixture, side) && "font-bold text-ink-950",
            !won?(@fixture, side) && "text-ink-400"
          ]}>
            {side_score(@fixture, side) || 0}
          </span>
        </div>
      </div>

      <dl class="grid grid-cols-2 gap-x-4 gap-y-2.5 border-t border-ink-200 px-5 py-4 text-[13px]">
        <div>
          <dt class="text-[11px] font-semibold uppercase tracking-[0.06em] text-ink-400">
            Stage
          </dt>
          <dd class="text-ink-950">{@fixture.round.stage.name}</dd>
        </div>
        <div>
          <dt class="text-[11px] font-semibold uppercase tracking-[0.06em] text-ink-400">
            Race to
          </dt>
          <dd class="text-ink-950">{@fixture.round.race_to || "—"}</dd>
        </div>
        <div>
          <dt class="text-[11px] font-semibold uppercase tracking-[0.06em] text-ink-400">
            Start
          </dt>
          <dd class="text-ink-950">{start_label(@fixture) || "Not scheduled yet"}</dd>
        </div>
        <div>
          <dt class="text-[11px] font-semibold uppercase tracking-[0.06em] text-ink-400">
            Reference
          </dt>
          <dd class="font-mono text-[12px] text-ink-600">{@fixture.match_id}</dd>
        </div>
      </dl>
    </div>

    <p :if={@fixture} class="mt-3 text-center text-[12px] text-ink-400">
      This page updates itself as frames are recorded.
    </p>
  </main>
</div>
