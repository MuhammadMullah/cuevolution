<PlayerComponents.flash_group flash={@flash} />

<div class="min-h-screen bg-ink-25 font-sans text-ink-700 antialiased">
  <!-- nav -->
  <header class="bg-ink-950">
    <div class="mx-auto flex max-w-6xl items-center justify-between gap-2 px-4 py-4 sm:gap-4 sm:px-8 sm:py-5">
      <img
        src={~p"/images/cuevolution-logo-white.png"}
        alt="Cuevolution"
        class="h-5 w-auto shrink-0 sm:h-6"
      />
      <nav class="hidden items-center gap-7 sm:flex">
        <a href="#mission" class="text-sm font-semibold text-ink-300 hover:text-white">Mission</a>
        <a href="#partners" class="text-sm font-semibold text-ink-300 hover:text-white">
          Partners
        </a>
        <a href="#feedback" class="text-sm font-semibold text-ink-300 hover:text-white">
          Feedback
        </a>
      </nav>
      <div class="flex shrink-0 items-center gap-1.5 sm:gap-2.5">
        <PlayerComponents.button
          navigate={~p"/login"}
          variant="cta-outline"
          class="whitespace-nowrap px-3 py-2 text-xs sm:px-5 sm:py-2.5 sm:text-sm"
        >
          Sign in
        </PlayerComponents.button>
        <PlayerComponents.button
          navigate={~p"/register"}
          variant="cta"
          class="whitespace-nowrap px-3 py-2 text-xs sm:px-5 sm:py-2.5 sm:text-sm"
        >
          Register
        </PlayerComponents.button>
      </div>
    </div>
  </header>
  <!-- hero -->
  <div class="overflow-hidden bg-ink-950">
    <div class="mx-auto grid max-w-6xl grid-cols-1 items-center px-5 sm:grid-cols-2 sm:px-8 sm:min-h-[88vh]">
      <div class="flex flex-col justify-center py-16 sm:py-24">
        <div class="max-w-[560px]">
          <img src={~p"/images/Pool league.png"} alt="Pool league" class="mb-1 h-42 w-auto" />
          <PlayerComponents.eyebrow class="mb-5 text-red-300">
            Kenya's Pool Circuit
          </PlayerComponents.eyebrow>
          <h1 class="mb-5 text-4xl leading-[1.05] font-bold tracking-tight text-ink-25 sm:text-6xl">
            Every rack starts somewhere.
          </h1>
          <p class="mb-8 max-w-[52ch] text-lg leading-relaxed text-ink-300 sm:text-xl">
            Register, get drawn into fixtures, and climb from a grassroots night at your local table all the way to the national circuit.
          </p>
          <PlayerComponents.button
            navigate={~p"/register"}
            variant="cta"
            class="px-8 py-4 text-base"
          >
            Register to play
          </PlayerComponents.button>
        </div>
      </div>
      <img
        src={~p"/images/WEBSITE.png"}
        alt="Cuevolution players from clubs across Kenya's pool circuit"
        class="hidden h-auto w-full max-w-none object-contain sm:block sm:w-[106%] sm:max-h-[85vh] sm:translate-x-[3%] xl:w-[120%] xl:translate-x-[8%]"
      />
    </div>
  </div>
  <!-- mission -->
  <div id="mission" class="bg-white px-5 py-16 sm:px-8 sm:py-24">
    <div class="mx-auto max-w-3xl text-center">
      <PlayerComponents.eyebrow class="mb-4 justify-center">
        Why Cuevolution
      </PlayerComponents.eyebrow>
      <h2 class="mb-4 text-2xl font-bold tracking-tight text-ink-950 sm:text-[32px]">
        One community, every level.
      </h2>
      <p class="text-base leading-relaxed text-ink-600 sm:text-[17px]">
        We bring Kenya's pool players together in one place to interact, compete and showcase their talent — from grassroots nights at the local table all the way to the national stage.
      </p>
    </div>
    <div class="mx-auto mt-12 grid max-w-5xl grid-cols-1 gap-10 sm:mt-14 sm:grid-cols-3 sm:gap-6">
      <div class="text-center">
        <img
          src={~p"/images/interact.jpg"}
          alt="Players competing at a Cuevolution match"
          class="mb-4 aspect-[4/3] w-full rounded-md object-cover"
        />
        <div class="mb-1.5 text-[15px] font-bold text-ink-950">Interact</div>
        <div class="text-[13.5px] text-ink-500">Find players and teams near you</div>
      </div>
      <div class="text-center">
        <img
          src={~p"/images/compete.jpg"}
          alt="Players competing at a Cuevolution match"
          class="mb-4 aspect-[4/3] w-full rounded-md object-cover"
        />
        <div class="mb-1.5 text-[15px] font-bold text-ink-950">Compete</div>
        <div class="text-[13.5px] text-ink-500">Fixtures, standings and results in real time</div>
      </div>
      <div class="text-center">
        <img
          src={~p"/images/showcase.jpeg"}
          alt="Winners celebrating with medals"
          class="mb-4 aspect-[4/3] w-full rounded-md object-cover"
        />
        <div class="mb-1.5 text-[15px] font-bold text-ink-950">Showcase</div>
        <div class="text-[13.5px] text-ink-500">Climb the ranks toward the national finals</div>
      </div>
    </div>
  </div>
  <!-- partners -->
  <div id="partners" class="border-t border-ink-200 bg-ink-50 px-5 py-14 sm:px-8 sm:py-[76px]">
    <div class="mb-9 text-center">
      <PlayerComponents.eyebrow class="mb-2.5 justify-center">Backed by</PlayerComponents.eyebrow>
      <h2 class="text-xl font-bold tracking-tight text-ink-950 sm:text-2xl">Our partners</h2>
    </div>
    <div class="mx-auto flex max-w-4xl flex-wrap items-center justify-center gap-5">
      <div
        :for={partner <- @partners}
        class={[
          "flex h-28 w-[45%] items-center justify-center overflow-hidden rounded-md px-6 shadow-sm sm:w-48",
          partner.tile_class
        ]}
      >
        <img src={~p"/images/#{partner.logo}"} alt={partner.name} class={partner.img_class} />
      </div>
    </div>
  </div>
  <!-- feedback -->
  <div id="feedback" class="bg-ink-25 px-5 py-16 sm:px-8 sm:py-[76px]">
    <div class="mx-auto max-w-lg text-center">
      <PlayerComponents.eyebrow class="mb-3 justify-center">
        Tell us what you think
      </PlayerComponents.eyebrow>
      <h2 class="mb-2.5 text-xl font-bold tracking-tight text-ink-950 sm:text-[26px]">
        Share feedback
      </h2>
      <p class="mb-7 text-sm text-ink-500 sm:text-[14.5px]">
        Ideas, bugs, or anything you want to see on Cuevolution — we read every submission.
      </p>
    </div>
    <form class="mx-auto flex max-w-md flex-col gap-3.5">
      <PlayerComponents.input name="name" type="text" value="" placeholder="Your name" />
      <PlayerComponents.input name="email" type="email" value="" placeholder="Your email" />
      <PlayerComponents.input
        name="message"
        type="textarea"
        value=""
        placeholder="Your feedback"
        rows="4"
      />
      <PlayerComponents.button type="submit" variant="cta" class="mx-auto px-7">
        Send feedback
      </PlayerComponents.button>
    </form>
  </div>
  <!-- footer -->
  <footer class="flex flex-wrap items-center justify-between gap-4 bg-ink-950 px-5 py-7 sm:px-8">
    <img
      src={~p"/images/cuevolution-logo-white.png"}
      alt="Cuevolution"
      class="h-[18px] w-auto opacity-90"
    />
    <div class="flex items-center gap-5">
      <a href="#feedback" class="text-[13px] font-semibold text-ink-300 hover:text-white">
        Share feedback
      </a>
      <div class="text-[12.5px] text-ink-500">© 2026 Cuevolution. All rights reserved.</div>
    </div>
  </footer>
</div>
