# Copy to .env in this same directory on the server
# (/opt/cuevolution-production/.env, see deploy/README.md), never committed.
# Referenced by docker-compose.yml via deploy.sh.
#
# DATABASE_URL, SECRET_KEY_BASE, SMTP_USERNAME/PASSWORD, and
# AFRICASTALKING_API_KEY/USERNAME are deliberately NOT here — deploy.sh
# fetches them fresh from Secret Manager on every deploy (same secrets Cloud
# Run already reads), so nothing secret sits in this file on disk.

# Set by deploy.sh on each run — do not hand-edit.
IMAGE=ghcr.io/muhammadmullah/cuevolution:production

# Must match a hostname in deploy/caddy/Caddyfile — that's how the shared
# Caddy reverse proxy addresses this app container.
APP_CONTAINER_NAME=cuevolution-production

# Cloud SQL, reached through the cloud-sql-proxy sidecar (no credentials file
# needed — it authenticates as the VM's attached service account). Get the
# connection name from `terraform output db_connection_name`.
CLOUDSQL_CONNECTION_NAME=change-me:region:instance

# db-f1-micro allows ~25 total connections. This VM is the only thing
# connecting now that Cloud Run is decommissioned, so app + worker (10 each,
# 20 total) fit comfortably. If Cloud Run ever comes back temporarily
# (rollback), drop this to ~3 to share the budget — see "too_many_connections"
# in app/deploy/README.md.
POOL_SIZE=10

# Public domain — must match one of the site blocks in deploy/caddy/Caddyfile.
DOMAIN=sportpesapool.ke

# Google Cloud Storage (profile picture storage — see
# lib/cuevolution/accounts/profile_picture/storage/gcs.ex). The bucket is
# private; the app authenticates as the VM's attached service account
# (`terraform output vm_service_account`) and serves photos through
# short-lived V4 signed URLs.
PROFILE_PICTURE_STORAGE=gcs
GCS_BUCKET=
GCS_SIGNING_SERVICE_ACCOUNT=

# Mail — see config/runtime.exs's MAIL_PROVIDER cases. Production uses
# smtp_auth (Gmail SMTP relay, smtp.gmail.com:587); the credentials
# themselves come from CUEVOLUTION_SECRETS_JSON (see deploy.sh), not here.
MAIL_PROVIDER=smtp_auth
MAIL_FROM_ADDRESS=notifications@cuevolutionke.com

# Africa's Talking sender ID isn't secret (the API key/username are, and
# come from CUEVOLUTION_SECRETS_JSON instead — see deploy.sh).
AFRICASTALKING_SENDER_ID=
