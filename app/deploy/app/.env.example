# Copy to .env in this same directory on the server — one per environment
# (deploy/README.md: /opt/cuevolution-staging/.env and
# /opt/cuevolution-production/.env), never committed. Referenced by
# docker-compose.yml in this directory.

# Set by the deploy workflow on each run — do not hand-edit.
IMAGE=ghcr.io/muhammadmullah/cuevolution:staging

# Must be unique per environment on this server — it's how the shared
# Caddy reverse proxy (deploy/caddy/) addresses this app container.
# Matches a hostname in deploy/caddy/Caddyfile.
APP_CONTAINER_NAME=cuevolution-staging

# Postgres
POSTGRES_USER=cuevolution
POSTGRES_PASSWORD=change-me
POSTGRES_DB=cuevolution_staging
POOL_SIZE=10

# Phoenix — generate with: mix phx.gen.secret (run locally, paste the output)
SECRET_KEY_BASE=change-me

# Public domain this environment is served from — must match one of the
# site blocks in deploy/caddy/Caddyfile.
DOMAIN=staging.cuevolutionke.com

# AWS S3 (profile picture storage — see
# lib/cuevolution/accounts/profile_picture/storage/s3.ex). The bucket is
# private; the app reads/writes it via these IAM credentials and serves
# photos through short-lived presigned URLs, not a public endpoint — see
# deploy/README.md for the minimal IAM policy this key needs.
# Use a separate bucket per environment.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
S3_BUCKET=

# Postmark (see lib/cuevolution/notifications/emails.ex and
# config/runtime.exs) — sends over Postmark's SMTP relay.
# MAIL_FROM_ADDRESS must be a verified Sender Signature (or address on a
# verified/DKIM'd domain) in Postmark, or sends are rejected.
# POSTMARK_SMTP_USERNAME/PASSWORD are both the Server API Token from the
# Postmark server's API Tokens tab — see deploy/README.md.
# Port 2525, not 587: this host's outbound 587 times out at the network
# level (confirmed via gen_tcp.connect from inside the app container) —
# 2525 is Postmark's alternate port for exactly this situation.
MAIL_FROM_ADDRESS=notifications@cuevolutionke.com
POSTMARK_SMTP_HOST=smtp.postmarkapp.com
POSTMARK_SMTP_PORT=2525
POSTMARK_SMTP_USERNAME=
POSTMARK_SMTP_PASSWORD=

# Twilio (see lib/cuevolution/notifications/sms_adapter/twilio_adapter.ex)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
