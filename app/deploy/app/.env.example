# Copy to .env in this same directory on the server — one per environment
# (deploy/README.md: /opt/cuevolution-staging/.env and
# /opt/cuevolution-production/.env), never committed. Referenced by
# docker-compose.yml in this directory.

# Set by the deploy workflow on each run — do not hand-edit.
IMAGE=ghcr.io/muhammadmullah/cuevolution:staging

# Must be unique per environment on this server — it's how the shared
# Caddy reverse proxy (deploy/caddy/) addresses this app container.
# Matches a hostname in deploy/caddy/Caddyfile.
APP_CONTAINER_NAME=cuevolution-staging

# Postgres
POSTGRES_USER=cuevolution
POSTGRES_PASSWORD=change-me
POSTGRES_DB=cuevolution_staging
POOL_SIZE=10
# The legacy Docker Compose PostgreSQL container does not have TLS enabled.
# Cloud Run must set DB_SSL=true when connecting to Cloud SQL directly.
DB_SSL=false

# Phoenix — generate with: mix phx.gen.secret (run locally, paste the output)
SECRET_KEY_BASE=change-me

# Public domain this environment is served from — must match one of the
# site blocks in deploy/caddy/Caddyfile.
DOMAIN=staging.sportpesapool.ke

# Google Cloud Storage (profile picture storage — see
# lib/cuevolution/accounts/profile_picture/storage/gcs.ex). The bucket is
# private; Cloud Run uses its service account and serves photos through
# short-lived V4 signed URLs. Use a separate bucket per environment.
PROFILE_PICTURE_STORAGE=gcs
GCS_BUCKET=
GCS_SIGNING_SERVICE_ACCOUNT=

# Postmark (see lib/cuevolution/notifications/emails.ex and
# config/runtime.exs) — sends over Postmark's HTTPS API (not SMTP — SMTP
# hit a wall of network/TLS issues on this host; see runtime.exs).
# MAIL_FROM_ADDRESS must be a verified Sender Signature (or address on a
# verified/DKIM'd domain) in Postmark, or sends are rejected.
# POSTMARK_API_KEY is the Server API Token from the Postmark server's API
# Tokens tab — see deploy/README.md.
MAIL_FROM_ADDRESS=notifications@cuevolutionke.com
POSTMARK_API_KEY=

# Africa's Talking (see
# lib/cuevolution/notifications/sms_adapter/africas_talking_adapter.ex)
AFRICASTALKING_API_KEY=
AFRICASTALKING_USERNAME=
AFRICASTALKING_SENDER_ID=
