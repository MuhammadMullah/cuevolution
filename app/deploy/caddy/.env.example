# Copy to .env in this same directory on the server (/opt/caddy/.env) —
# deployed once, shared by every environment (see deploy/README.md).

# Address Let's Encrypt can reach you at about certificate issues.
CADDY_EMAIL=change-me

# Cloudflare API token scoped to Zone:DNS:Edit for sportpesapool.ke's zone
# only (Cloudflare dashboard -> My Profile -> API Tokens -> Create Token ->
# "Edit zone DNS" template, restrict to this zone). Lets Caddy prove domain
# ownership via DNS-01 (Caddyfile) instead of HTTP-01, so it can fetch/renew
# the cert before DNS points here — see deploy/README.md.
CF_API_TOKEN=change-me
