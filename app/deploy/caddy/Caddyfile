# Container name here must match APP_CONTAINER_NAME in deploy/app/.env (see
# deploy/README.md) — that's what makes the app reachable by name on the
# shared "web" network.

# DNS-01 via Cloudflare: proves ownership by creating a TXT record through
# the Cloudflare API, so this cert can be (re)issued whether or not DNS
# currently points here — the key to a zero-downtime cutover.
sportpesapool.ke {
	tls {
		dns cloudflare {$CF_API_TOKEN}
	}

	handle {
		reverse_proxy cuevolution-production:4000
	}
}
