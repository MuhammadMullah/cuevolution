# Copy to .env on the server (staging and production each get their own,
# never committed) and fill in real values. Referenced by docker-compose.yml.

# Set by the deploy workflow on each run — do not hand-edit.
IMAGE=ghcr.io/muhammadmullah/cuevolution:staging

# Postgres
POSTGRES_USER=cuevolution
POSTGRES_PASSWORD=change-me
POSTGRES_DB=cuevolution_prod
POOL_SIZE=10

# Phoenix — generate with: mix phx.gen.secret (run locally, paste the output)
SECRET_KEY_BASE=change-me

# Public domain this environment is served from (e.g. staging.cuevolution.app)
DOMAIN=change-me
# Address Let's Encrypt can reach you at about certificate issues
CADDY_EMAIL=change-me

# Africa's Talking (see lib/cuevolution/notifications/sms_adapter/africas_talking_adapter.ex)
AFRICASTALKING_API_KEY=
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_SENDER_ID=

# Twilio — optional alternative adapter, inactive unless :sms_adapter is
# switched to it (see lib/cuevolution/notifications/sms_adapter/twilio_adapter.ex)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
