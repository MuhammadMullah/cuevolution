# Copy to production.tfvars; this file must not be committed with real values.
project_id                = "REPLACE_WITH_PRODUCTION_PROJECT_ID"
region                    = "africa-south1"
image                     = "africa-south1-docker.pkg.dev/REPLACE_WITH_PRODUCTION_PROJECT_ID/cuevolution-images/cuevolution@sha256:REPLACE_WITH_IMAGE_DIGEST"
cloud_sql_connection_name = "REPLACE_WITH_PRODUCTION_PROJECT_ID:africa-south1:REPLACE_WITH_INSTANCE_NAME"
storage_bucket            = "REPLACE_WITH_PRODUCTION_GCS_BUCKET_NAME"
mail_from_address         = "admin@cuevolutionke.com"
africastalking_sender_id  = "REPLACE_WITH_SENDER_ID_IF_USED"
